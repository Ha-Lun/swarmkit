{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/nemotron-3.5-lightning-free",
  "default_agent": "lead-dev",
  "instructions": ["{env:HOME}/.config/opencode/custom-instructions.md"],
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "mcp": {
    "cloudflare": { "type": "remote", "url": "https://mcp.cloudflare.com/mcp", "enabled": true, "oauth": {} },
    "cloudflare-docs": { "type": "remote", "url": "https://docs.mcp.cloudflare.com/mcp", "enabled": true },
    "cloudflare-bindings": { "type": "remote", "url": "https://bindings.mcp.cloudflare.com/mcp", "enabled": true, "oauth": {} },
    "cloudflare-builds": { "type": "remote", "url": "https://builds.mcp.cloudflare.com/mcp", "enabled": true, "oauth": {} },
    "cloudflare-observability": { "type": "remote", "url": "https://observability.mcp.cloudflare.com/mcp", "enabled": true, "oauth": {} },
    "gemini-mcp-tool": {
      "type": "local",
      "command": ["npx", "-y", "gemini-mcp-tool@1.1.8"]
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@4.21.3", "mcp"]
    },
    "21st-dev-magic": {
      "type": "local",
      "command": ["npx", "-y", "@21st-dev/magic@0.2.3"],
      "environment": {
        "API_KEY": "{env:MAGIC_MCP_API_KEY}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@1.10.1"]
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp@3.28.2"]
    },
    "blender": {
      "type": "local",
      "command": ["uvx", "blender-mcp@2.0.0"]
    },
    "google-trends": {
      "type": "local",
      "command": ["npx", "-y", "google-trends-mcp@0.1.1"]
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.83"]
    }
  },
  "permission": {
    "bash": "allow"
  }
}
