# Claude Fleet: always-on dashboard, reachable only through `tailscale serve` (see dashboard/README.md).
# Install: ln -sf /home/ha-lun/opencode-config/dashboard/deploy/claude-fleet.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now claude-fleet.service
[Unit]
Description=Claude Fleet — Claude Code control dashboard (127.0.0.1:4317, served on the tailnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ha-lun/opencode-config/dashboard
Environment=HOST=127.0.0.1
Environment=PORT=4317
Environment=NODE_ENV=production
Environment=PATH=/home/ha-lun/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/home/linuxbrew/.linuxbrew/bin/npm run build
ExecStart=/home/ha-lun/opencode-config/dashboard/node_modules/.bin/tsx server/index.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
# No ProtectSystem=strict: Claude sessions started from the page must be able to write in your projects.

[Install]
WantedBy=default.target
