---
// The one Reference section, after the finale: everything the scenes leave out, compact. It also keeps the no-3D
// fallback a complete page. All lists are derived from the repo at build time (facts, routing, benchmarks, build log).
// Shell: a sticky index rail (chip row on small screens) plus one readable column of six numbered sections.
import RoutingDiagram from './RoutingDiagram.astro';
import { facts, repoUrl } from '../lib/facts';
import { roleLine } from '../lib/agents';
import { bandLabels, bandOrder } from '../content/tiers';
import { examples, gates, tiers } from '../content/routing';
import { loadBenchmarks } from '../lib/benchmarks';
import { loadBuildlog } from '../lib/buildlog';

const { agents, platforms, flags, mcpServers, skills, commands } = facts;
const bench = loadBenchmarks();
const log = loadBuildlog();
const fmt = (ts: string) => ts.slice(0, 16).replace('T', ' ') + ' UTC';
const groups = bandOrder
  .map((band) => ({ band, ...bandLabels[band], members: agents.filter((a) => a.band === band) }))
  .filter((g) => g.members.length > 0);
const installCmd = './install.sh --all';
const h = 'm-0 font-mono text-sm font-normal uppercase tracking-widest text-wax';
const sections = [
  { id: 'ref-install', label: 'Install', summary: 'Clone the repo and run one script; it links everything into place.' },
  { id: 'ref-routing', label: 'How it routes', summary: 'A request is classified into a tier, explored if needed, executed, then checked.' },
  { id: 'ref-roster', label: 'Roster', summary: `${agents.length} agents, grouped by the job they do.` },
  { id: 'ref-extend', label: 'Extend', summary: 'MCP servers, skills and slash commands that ship with the kit.' },
  { id: 'ref-proof', label: 'Proof', summary: 'What is measured, what is not yet, and how this site was made.' },
  { id: 'ref-log', label: 'Build log', summary: 'Who did what, read from the repo at build time.' },
];
const num = (i: number) => String(i + 1).padStart(2, '0');
const [sInstall, sRouting, sRoster, sExtend, sProof, sLog] = sections;
---
<section id="reference" class="ref" aria-labelledby="reference-title">
  <div class="ref-wrap">
    <header class="ref-head">
      <h2 id="reference-title" class="ref-title">Reference</h2>
      <p class="ref-lede">
        The detail behind the scroll. You write every agent, skill and rule once in <code>core/</code>; a small
        compiler turns them into each CLI's native format and the installer links the results into place.
      </p>
    </header>

    <div class="ref-shell">
      <nav class="ref-rail" aria-label="Reference sections">
        <ol class="ref-rail-list">
          {sections.map((s, i) => (
            <li><a href={`#${s.id}`} class="ref-rail-link" data-ref-link={s.id}><span class="ref-rail-n">{num(i)}</span>{s.label}</a></li>
          ))}
        </ol>
      </nav>

      <div class="ref-main">
        <section id={sInstall.id} class="ref-section" aria-labelledby={`${sInstall.id}-h`}>
          <p class="ref-eyebrow">{num(0)} / {sInstall.label}</p>
          <h3 id={`${sInstall.id}-h`} class="ref-h">{sInstall.label}</h3>
          <p class="ref-sum">{sInstall.summary}</p>
          <pre class="mb-0 mt-6 overflow-x-auto font-mono text-sm leading-relaxed"><code>git clone {repoUrl}.git
cd swarmkit
{installCmd}</code></pre>
          <p class="mb-0 mt-3 text-text">Anything it replaces is backed up first. Running it again changes nothing. <code class="font-mono text-sm">--all</code> is also the default when no flag is given.</p>
          <h4 class={`${h} mt-8`}>Platforms</h4>
          <dl class="mb-0 mt-3 grid gap-3">
            {platforms.map((p) => (
              <div>
                <dt><span class="font-display font-bold">{p.name}</span> <code class="font-mono text-sm text-text">{p.flag}</code></dt>
                <dd class="m-0 text-text">{p.summary}</dd>
              </div>
            ))}
          </dl>
          <h4 class={`${h} mt-8`}>Installer flags</h4>
          <dl class="mb-0 mt-3 grid gap-2">
            {flags.map((f) => (
              <div class="grid grid-cols-[104px_1fr] gap-3">
                <dt class="font-mono text-sm">{f.flag}</dt>
                <dd class="m-0 text-text">{f.description}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section id={sRouting.id} class="ref-section" aria-labelledby={`${sRouting.id}-h`}>
          <p class="ref-eyebrow">{num(1)} / {sRouting.label}</p>
          <h3 id={`${sRouting.id}-h`} class="ref-h">{sRouting.label}</h3>
          <p class="ref-sum">{sRouting.summary}</p>
          <h4 class={`${h} mt-6`}>Tiered routing</h4>
          <dl class="mb-0 mt-3 grid gap-2">
            {tiers.map((t) => (
              <div class="grid grid-cols-[32px_1fr] gap-3">
                <dt class="font-mono text-sm text-text">{t.id}</dt>
                <dd class="m-0"><span class="font-display font-bold">{t.title}.</span> <span class="text-text">{t.body}</span></dd>
              </div>
            ))}
          </dl>
          <p class="mb-0 mt-3 font-mono text-sm text-text">T0 to T3 are routing tiers (how much ceremony a task gets). fast, standard and deep are model tiers (which model class runs an agent).</p>
          <figure class="m-0 mt-8 max-w-[760px]">
            <div class="hidden md:block"><RoutingDiagram /></div>
            <div class="mx-auto max-w-[360px] md:hidden"><RoutingDiagram vertical /></div>
            <figcaption class="mb-0 mt-2 font-mono text-sm text-text">Explore is for non-trivial work or uncertain context. It can be skipped when the task is self-contained.</figcaption>
          </figure>
          <h4 class={`${h} mt-8`}>Example routes</h4>
          <p class="mb-0 mt-2 text-text">Illustrative: the actual route depends on what the change touches.</p>
          <ul class="m-0 mt-3 grid list-none gap-4 p-0">
            {examples.map((e) => (
              <li>
                <p class="m-0"><span class="font-display font-bold">{e.task}</span> <span class="font-mono text-sm text-text">{e.tier}</span></p>
                <ol class="mb-0 mt-1 list-decimal pl-5 text-text">
                  {e.route.map((r) => <li>{r.label}{r.agent && <> <code class="font-mono text-sm text-text">{r.agent}</code></>}</li>)}
                </ol>
              </li>
            ))}
          </ul>
          <h4 class={`${h} mt-8`}>Quality gates</h4>
          <p class="mb-0 mt-2 text-text">Run after the work, in parallel where the CLI allows, and only when relevant. Worktrees are never merged or removed without an explicit instruction.</p>
          <ul class="m-0 mt-2 grid list-none gap-1 p-0">
            {gates.map((g) => <li><code class="font-mono text-sm">{g.agent}</code> <span class="text-text">when {g.when}</span></li>)}
          </ul>
        </section>

        <section id={sRoster.id} class="ref-section" aria-labelledby={`${sRoster.id}-h`}>
          <p class="ref-eyebrow">{num(2)} / {sRoster.label}</p>
          <h3 id={`${sRoster.id}-h`} class="ref-h">{sRoster.label}</h3>
          <p class="ref-sum">{sRoster.summary}</p>
          <div class="mt-6 grid grid-cols-1 gap-x-12 gap-y-8 md:grid-cols-2">
            {groups.map((g) => (
              <div>
                <h4 class="m-0 font-display text-base font-bold">{g.title} <span class="font-mono text-sm font-normal text-text">{g.members.length}</span></h4>
                <p class="mb-0 mt-1 text-text">{g.note}</p>
                <ul class="m-0 mt-3 grid list-none gap-2 p-0" aria-label={g.title}>
                  {g.members.map((a) => (
                    <li data-agent-ref={a.name}>
                      <code class="font-mono text-sm">{a.name}</code> <span class="font-mono text-sm text-text">{a.tier}</span>
                      <span class="block text-text">{roleLine(a, 72)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section id={sExtend.id} class="ref-section" aria-labelledby={`${sExtend.id}-h`}>
          <p class="ref-eyebrow">{num(3)} / {sExtend.label}</p>
          <h3 id={`${sExtend.id}-h`} class="ref-h">{sExtend.label}</h3>
          <p class="ref-sum">{sExtend.summary}</p>
          <div class="mt-6 grid grid-cols-1 gap-x-12 gap-y-8">
            <div>
              <h4 class={h}>MCP servers <span class="text-text">{mcpServers.length}</span></h4>
              <p class="mb-0 mt-2 text-text">Registered for Claude Code and Antigravity from <code class="font-mono text-sm">core/mcp.json</code>.</p>
              <ul class="m-0 mt-3 flex list-none flex-wrap gap-2 p-0">
                {mcpServers.map((m) => <li class="border border-wax-dim px-2 py-1 font-mono text-sm">{m}</li>)}
              </ul>
            </div>
            <div>
              <h4 class={h}>Skills <span class="text-text">{skills.length}</span></h4>
              <p class="mb-0 mt-2 text-text">Shared by all three CLIs, from <code class="font-mono text-sm">core/skills/</code>.</p>
              <ul class="m-0 mt-3 flex list-none flex-wrap gap-2 p-0">
                {skills.map((s) => <li class="border border-wax-dim px-2 py-1 font-mono text-sm">{s}</li>)}
              </ul>
            </div>
            <div>
              <h4 class={h}>Slash commands <span class="text-text">{commands.length}</span></h4>
              <p class="mb-0 mt-2 text-text">OpenCode.</p>
              <dl class="mb-0 mt-3 grid gap-2">
                {commands.map((c) => (
                  <div><dt class="font-mono text-sm">{c.name}</dt><dd class="m-0 text-text">{c.description}</dd></div>
                ))}
              </dl>
            </div>
          </div>
        </section>

        <section id={sProof.id} class="ref-section" aria-labelledby={`${sProof.id}-h`}>
          <p class="ref-eyebrow">{num(4)} / {sProof.label}</p>
          <h3 id={`${sProof.id}-h`} class="ref-h">{sProof.label}</h3>
          <p class="ref-sum">{sProof.summary}</p>
          <div class="mt-6 grid grid-cols-1 gap-x-12 gap-y-8">
            <div data-proof="ponytail">
              <h4 class="m-0 font-display text-base font-bold">Ponytail diff</h4>
              <p class="mb-0 mt-1 font-mono text-sm">net: pending</p>
              <p class="mb-0 mt-1 text-text">Ponytail is the always-on discipline against over-engineering. No before-and-after diff has been recorded yet, so no figure is shown.</p>
            </div>
            <div data-proof="benchmarks">
              <h4 class="m-0 font-display text-base font-bold">Benchmarks</h4>
              {bench ? (
                <>
                  <div class="mt-2 overflow-x-auto">
                    <table class="w-full border-collapse text-left font-mono text-sm">
                      <thead><tr>{bench.columns.map((c) => <th scope="col" class="border-b border-wax-dim py-2 pr-4 font-normal text-text">{c}</th>)}</tr></thead>
                      <tbody>{bench.rows.map((r) => <tr>{bench.columns.map((c) => <td class="border-b border-ink-2 py-2 pr-4">{r[c] ?? ''}</td>)}</tr>)}</tbody>
                    </table>
                  </div>
                  <p class="mb-0 mt-2"><a href={bench.rawHref} class="underline underline-offset-4">Raw data (JSON)</a></p>
                </>
              ) : (
                <>
                  <p class="mb-0 mt-1 font-mono text-sm">benchmarks pending</p>
                  <p class="mb-0 mt-1 text-text">No benchmark data has been recorded yet. When it exists it will show medians over at least three runs per fixture per agent type, with the raw file linked. Losses will be shown too.</p>
                </>
              )}
            </div>
            <div data-proof="harness">
              <h4 class="m-0 font-display text-base font-bold">Harness disclosure</h4>
              <p class="mb-0 mt-1 text-text">
                Benchmark runs: Antigravity (<code class="font-mono text-sm">agy</code>) with <code class="font-mono text-sm">gemini-3.8-flash-high</code>.{bench?.harness || bench?.model ? ` Recorded in the data file: ${[bench.harness, bench.model].filter(Boolean).join(', ')}.` : ''}{' '}
                This site: built with Claude Code, using the agents described above. The scene is procedural: no external models, textures or volume data, and no AI-generated media.
              </p>
            </div>
          </div>
        </section>

        <section id={sLog.id} class="ref-section" aria-labelledby={`${sLog.id}-h`}>
          <p class="ref-eyebrow">{num(5)} / {sLog.label}</p>
          <h3 id={`${sLog.id}-h`} class="ref-h">{sLog.label}</h3>
          <p class="ref-sum">{sLog.summary} It separates what the human did from what agents did.</p>
          <dl class="mb-0 mt-6 grid grid-cols-1 gap-x-12 gap-y-3 md:grid-cols-2">
            <div>
              <dt class="font-mono text-sm text-text">Human interventions</dt>
              <dd class="m-0"><span class="font-display text-lg font-bold">{log.interventions}</span> <span class="text-text">{log.gates} gate approvals, {log.decisions} decisions and answers, {log.artRounds} art-direction rounds with a human verdict. Measurements and agent-applied changes are not counted.</span></dd>
            </div>
            <div>
              <dt class="font-mono text-sm text-text">Agent dispatches</dt>
              <dd class="m-0"><span class="font-display text-lg font-bold">{log.dispatches}</span> <span class="text-text">{log.dispatchesByAgent.map(([a, n]) => `${a} ${n}`).join(', ') || 'none recorded'}</span></dd>
            </div>
          </dl>
          <details class="mt-4">
            <summary class="cursor-pointer font-mono text-sm text-text">Build timeline ({log.events.length} events)</summary>
            <ol class="m-0 mt-3 list-none border-l border-wax-dim p-0" aria-label="Build timeline">
              {log.events.map((e) => (
                <li class="relative py-2 pl-5" data-actor={e.actor}>
                  <span class="absolute -left-[3px] top-[14px] size-[5px] bg-wax" aria-hidden="true"></span>
                  <p class="m-0 font-mono text-sm text-text"><time datetime={e.ts}>{fmt(e.ts)}</time> / {e.actor} / {e.kind}</p>
                  <p class="mb-0 mt-1">{e.text}</p>
                </li>
              ))}
            </ol>
          </details>
        </section>

        <p class="ref-foot" data-slot="horology">
          <span class="text-text">Horology demo: link coming.</span>
          <a href={repoUrl} class="underline underline-offset-4">Source: github.com/ha-lun/swarmkit</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Shell. Tokens only; no new colours. Hierarchy from size and weight; wax for labels; dim borders between sections. */
  .ref { position: relative; background: var(--ink); border-top: 1px solid var(--ink-2); padding: var(--space-24) var(--space-6) var(--space-16); color: var(--text); font-size: var(--text-base); }
  .ref-wrap { max-width: 75rem; margin: 0 auto; }
  .ref-title { margin: 0; font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; line-height: var(--leading-tight); }
  .ref-lede { margin: var(--space-2) 0 0; max-width: 72ch; }
  .ref-shell { margin-top: var(--space-12); } /* block on small screens so the chip row can stay pinned for the whole section */
  .ref-main { min-width: 0; }
  .ref-section { padding: var(--space-12) 0; border-top: 1px solid var(--ink-2); scroll-margin-top: 128px; }
  .ref-section:first-child { border-top: 1px solid var(--wax-dim); }
  .ref-eyebrow { margin: 0; font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: 0.08em; text-transform: uppercase; color: var(--wax); }
  .ref-h { margin: var(--space-2) 0 0; font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; line-height: var(--leading-tight); letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .ref-sum { margin: var(--space-3) 0 0; max-width: 60ch; font-size: var(--text-lg); line-height: 1.4; color: var(--text); }
  .ref-foot { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-8); margin: 0; padding-top: var(--space-8); border-top: 1px solid var(--ink-2); }

  /* Rail: chip row under the nav on small screens, sticky index at >= 1024px. */
  .ref-rail { position: sticky; top: 64px; z-index: 2; margin: 0 calc(var(--space-6) * -1); padding: var(--space-2) var(--space-6); background: var(--ink); border-bottom: 1px solid var(--ink-2); overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; }
  .ref-rail::-webkit-scrollbar { display: none; }
  .ref-rail-list { display: flex; gap: var(--space-2); margin: 0; padding: 0; list-style: none; width: max-content; }
  .ref-rail-link { display: inline-flex; gap: var(--space-2); align-items: baseline; padding: var(--space-2) var(--space-3); border: 1px solid var(--ink-2); font-family: var(--font-mono); font-size: var(--text-sm); color: var(--text); text-decoration: none; white-space: nowrap; }
  .ref-rail-n { color: var(--wax); }
  .ref-rail-link:hover { border-color: var(--wax-dim); }
  .ref-rail-link[aria-current] { border-color: var(--text); }

  @media (min-width: 1024px) {
    .ref-shell { display: grid; grid-template-columns: 200px minmax(0, 1fr); column-gap: var(--space-16); }
    .ref-section { scroll-margin-top: var(--space-24); }
    .ref-rail { top: var(--space-24); align-self: start; margin: 0; padding: 0; overflow: visible; border-bottom: 0; }
    .ref-rail-list { flex-direction: column; gap: 0; width: auto; border-left: 1px solid var(--ink-2); }
    .ref-rail-link { display: flex; margin-left: -1px; padding: var(--space-2) var(--space-4); border: 0; border-left: 2px solid transparent; }
    .ref-rail-link:hover { border-left-color: var(--wax-dim); }
    .ref-rail-link[aria-current] { border-left-color: var(--text); font-weight: 700; }
  }
  @media (max-width: 720px) {
    .ref { padding-left: var(--space-4); padding-right: var(--space-4); }
    .ref-rail { margin: 0 calc(var(--space-4) * -1); padding: var(--space-2) var(--space-4); }
  }
</style>

<script>
  // Scroll-spy for the index rail: only sets aria-current. No scrolling, no layout, no scroll listeners. The links are
  // plain anchors (Lenis handles them via its `anchors` option, the browser jumps natively without JS).
  const rail = document.querySelector<HTMLElement>('.ref-rail');
  if (rail) {
    const links = new Map([...rail.querySelectorAll<HTMLAnchorElement>('[data-ref-link]')].map((a) => [a.dataset.refLink!, a]));
    const sections = [...links.keys()].map((id) => document.getElementById(id)).filter((s): s is HTMLElement => !!s);
    const inBand = new Set<string>();
    const wide = window.matchMedia('(min-width: 1024px)');
    let current = '';
    const set = (id: string) => {
      if (id === current) return;
      current = id;
      links.forEach((a, key) => (key === id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      const a = links.get(id);
      if (a && !wide.matches && rail.scrollWidth > rail.clientWidth) {
        rail.scrollLeft = a.offsetLeft - (rail.clientWidth - a.offsetWidth) / 2; // centre the chip in its own row only
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) (e.isIntersecting ? inBand.add(e.target.id) : inBand.delete(e.target.id));
        const first = sections.find((s) => inBand.has(s.id));
        if (first) set(first.id);
        else if (sections[0].getBoundingClientRect().top > window.innerHeight * 0.3) {
          current = '';
          links.forEach((a) => a.removeAttribute('aria-current'));
        }
      },
      { rootMargin: '-25% 0px -65% 0px' }, // a section counts as current while it crosses the band near the top third
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
