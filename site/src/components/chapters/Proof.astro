---
// The Proof scene: a slim HUD strip of instrument readouts over the dimmed lattice. Every value is real or "pending".
import { harnessOf, loadBenchmarks } from '../../lib/benchmarks';
import { loadBuildlog } from '../../lib/buildlog';
import { motion } from '../../lib/world/motion-config';

const bench = loadBenchmarks();
const log = loadBuildlog();
const harness = harnessOf(bench);
---
<section id="proof" class="chapter" style={`--runway:${motion.runway.proof}`} aria-labelledby="proof-title">
  <div class="scene" data-scene>
    <div class="scene-foot scene-foot-stack">
      <h2 id="proof-title" class="caption" data-caption>Numbers come from runs, or they do not appear.</h2>
      <dl class="hud">
        <div class="hud-cell" data-hud data-fx data-proof="ponytail">
          <dt>ponytail diff</dt>
          <dd>net: pending</dd>
        </div>
        <div class="hud-cell" data-hud data-fx data-proof="benchmarks">
          <dt>benchmarks</dt>
          <dd>{bench ? <>{bench.rows.length} rows, <a href={bench.rawHref}>raw JSON</a></> : 'pending'}</dd>
        </div>
        <div class="hud-cell" data-hud data-fx data-proof="harness">
          <dt>harness</dt>
          <dd>bench: {harness}. site: Claude Code.</dd>
        </div>
        <div class="hud-cell" data-hud data-fx data-proof="buildlog">
          <dt>build log</dt>
          <dd>{log.interventions} human interventions, {log.dispatches} agent dispatches</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
