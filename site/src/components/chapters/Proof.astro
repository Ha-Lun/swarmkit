---
import { loadBenchmarks } from '../../lib/benchmarks';
import { loadBuildlog } from '../../lib/buildlog';

const bench = loadBenchmarks();
const log = loadBuildlog();
const fmt = (ts: string) => ts.slice(0, 16).replace('T', ' ') + ' UTC';
const stats = [
  { label: 'Human interventions', value: log.interventions, note: `${log.gates} gate approvals, ${log.decisions} decisions and answers, ${log.artRounds} art-direction rounds with a human verdict. Measurements and agent-applied changes are not counted.` },
  { label: 'Agent dispatches', value: log.dispatches, note: log.dispatchesByAgent.map(([a, n]) => `${a} ${n}`).join(', ') || 'none recorded' },
];
---
<section id="proof" class="chapter border-t border-ink-2 py-24" aria-labelledby="proof-title">
  <div class="mx-auto max-w-page px-6 md:px-8">
    <p class="eyebrow m-0">Chapter 3 / Proof</p>
    <h2 id="proof-title" class="mb-0 mt-4 max-w-[20ch] font-display text-2xl font-bold leading-tight">Numbers come from runs, or they do not appear.</h2>

    <div class="mt-12 grid grid-cols-1 gap-4 lg:grid-cols-2">
      <div class="panel p-6" data-proof="ponytail">
        <h3 class="m-0 font-display text-xl font-bold">Ponytail diff</h3>
        <p class="mb-0 mt-3 text-text">Ponytail is the always-on discipline against over-engineering. A ponytail review ends with the net lines that could be removed.</p>
        <p class="mb-0 mt-6 font-mono text-lg text-wax">net: pending</p>
        <p class="mb-0 mt-2 text-sm text-text">No before-and-after diff has been recorded yet. No figure is shown until one exists.</p>
      </div>

      <div class="panel p-6" data-proof="benchmarks">
        <h3 class="m-0 font-display text-xl font-bold">Benchmarks</h3>
        {bench ? (
          <>
            <div class="mt-6 overflow-x-auto">
              <table class="w-full border-collapse text-left font-mono text-xs">
                <thead>
                  <tr>{bench.columns.map((c) => <th scope="col" class="border-b border-wax-dim py-2 pr-4 font-normal text-wax">{c}</th>)}</tr>
                </thead>
                <tbody>
                  {bench.rows.map((r) => <tr>{bench.columns.map((c) => <td class="border-b border-ink py-2 pr-4 text-text">{r[c] ?? ''}</td>)}</tr>)}
                </tbody>
              </table>
            </div>
            <p class="mb-0 mt-4 text-sm"><a href={bench.rawHref} class="text-text underline underline-offset-4">Raw data (JSON)</a></p>
          </>
        ) : (
          <>
            <p class="mb-0 mt-3 font-mono text-lg text-wax">benchmarks pending</p>
            <p class="mb-0 mt-2 text-sm text-text">No benchmark data has been recorded yet. When it exists it will show medians over at least three runs per fixture per agent type, with the raw file linked. Losses will be shown too.</p>
          </>
        )}
      </div>
    </div>

    <div class="mt-4 panel p-6" data-proof="harness">
      <h3 class="m-0 font-display text-xl font-bold">Harness disclosure</h3>
      <dl class="mb-0 mt-4 grid grid-cols-1 gap-4 text-text md:grid-cols-2">
        <div>
          <dt class="font-mono text-xs uppercase tracking-widest text-wax">Benchmark runs</dt>
          <dd class="m-0 mt-2">Antigravity (<code class="font-mono text-sm">agy</code>) with <code class="font-mono text-sm">gemini-3.8-flash-high</code>.{bench?.harness || bench?.model ? ` Recorded in the data file: ${[bench.harness, bench.model].filter(Boolean).join(', ')}.` : ''}</dd>
        </div>
        <div>
          <dt class="font-mono text-xs uppercase tracking-widest text-wax">This site</dt>
          <dd class="m-0 mt-2">Built with Claude Code, using the agents described above. The scene is procedural: no external models, textures or volume data, and no AI-generated media.</dd>
        </div>
      </dl>
    </div>

    <h3 class="mb-0 mt-24 font-display text-xl font-bold">Built by SwarmKit</h3>
    <p class="mb-0 mt-3 max-w-[60ch] text-text">This log is read from the repo's build log at build time. It separates what the human did from what agents did.</p>
    <dl class="m-0 mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
      {stats.map((s) => (
        <div class="panel p-6">
          <dt class="font-mono text-xs uppercase tracking-widest text-wax">{s.label}</dt>
          <dd class="m-0 mt-2 font-display text-2xl font-bold">{s.value}</dd>
          <dd class="m-0 mt-2 text-sm text-text">{s.note}</dd>
        </div>
      ))}
    </dl>
    <ol class="m-0 mt-8 list-none border-l border-wax-dim p-0" aria-label="Build timeline">
      {log.events.map((e) => (
        <li class="relative py-3 pl-6" data-actor={e.actor}>
          <span class="absolute -left-[3px] top-[22px] size-[5px] bg-wax" aria-hidden="true"></span>
          <p class="m-0 font-mono text-xs text-wax"><time datetime={e.ts}>{fmt(e.ts)}</time> / {e.actor} / {e.kind}</p>
          <p class="mb-0 mt-1 text-sm text-text">{e.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
