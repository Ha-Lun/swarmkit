---
// The Cells scene: the task's journey. The step captions and chips of every journey are pre-rendered from the routing data (journeys.ts) and the chapter only writes their opacity: the current
// step's caption shows and its chip lights. The hidden agent list and the label cards are pre-rendered from the agent data; the full roster is in Reference. The band legend is the static
// page's (the world shows the steps instead).
import { facts } from '../../lib/facts';
import { roleLine } from '../../lib/agents';
import { blurb } from '../../lib/blurb';
import { bandLabels, bandOrder } from '../../content/tiers';
import { examples, gates, tiers } from '../../content/routing';
import { journeysOf } from '../../lib/journeys';
import { motion } from '../../lib/world/motion-config';

const agents = facts.agents;
const bands = bandOrder
  .map((band) => ({ band, ...bandLabels[band], count: agents.filter((a) => a.band === band).length }))
  .filter((b) => b.count > 0);
const ordered = bandOrder.flatMap((b) => agents.filter((a) => a.band === b));
const journeys = journeysOf(examples, gates.map((g) => g.agent), tiers);
const captionOf = (b: { label: string; agent?: string }) => (b.agent ? `${b.label}: ${b.agent}` : b.label);
---
<section id="cells" class="chapter" style={`--runway:${motion.runway.cells}`} aria-labelledby="cells-title">
  <div class="scene" data-scene>
    <h2 id="cells-title" class="sr-only">The roster</h2>

    <div class="agent-list world-only" role="group" aria-label={`Agents (${agents.length}). Arrow keys move between them.`} data-agent-list>
      {ordered.map((a) => (
        <button type="button" class="agent-btn" data-agent={a.name} tabindex="-1">{a.name}, {a.tier} tier: {roleLine(a)}</button>
      ))}
    </div>
    <div class="world-only" aria-hidden="true">
      {ordered.map((a) => (
        <div class="cell-card" data-card={a.name}>
          <p class="cell-card-head"><span>{a.name}</span><span class="cell-card-tier">{a.tier}</span></p>
          <p class="cell-card-band">{bandLabels[a.band].title}</p>
          <p class="cell-card-role">{blurb(a.description)}</p>
          {a.capabilities.length > 0 && <ul class="cell-card-caps">{a.capabilities.slice(0, 5).map((c) => <li>{c}</li>)}</ul>}
        </div>
      ))}
    </div>

    <div class="scene-foot">
      <div class="captions">
        <p class="caption static-only">{agents.length} agents, one cell each.</p>
        {journeys.map((j, ji) => (
          <>
            {j.beats.map((b, bi) => b.stop >= 0 && <p class="caption world-only" data-caption-step data-j={ji} data-b={bi} data-fx>{captionOf(b)}</p>)}
            {j.gates.length > 0 && (
              <p class="caption world-only" data-caption-step data-j={ji} data-gates data-fx>
                In parallel: {j.beats.filter((b) => b.stop < 0).map((b) => `${b.agent} (${b.label})`).join(', ')}
              </p>
            )}
          </>
        ))}
      </div>
      <div class="chip-stack world-only">
        {journeys.map((j, ji) => (
          <ul class="chips" aria-label={`${j.task}: its steps`} data-steps={ji} data-fx>
            {j.beats.map((b, bi) => (
              <li class="chip" data-step data-b={bi}><i class="chip-ring" data-fx aria-hidden="true"></i><i class="chip-fill" aria-hidden="true"></i>{b.label}</li>
            ))}
          </ul>
        ))}
      </div>
      <ul class="chips static-only" aria-label="Agent groups, from the core outwards">
        {bands.map((b) => (
          <li class="chip" title={b.note}>{b.title} {b.count}</li>
        ))}
      </ul>
    </div>
  </div>
</section>
