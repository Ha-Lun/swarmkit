---
// The finale scene. In the world the command is the particle swarm, assembled at centre screen; this DOM copy of it is
// visually hidden then (still there for assistive tech and selection) and shown as text in the static fallback.
// The copy button sits beside the assembled text, and the chips come in only after it has formed.
import { facts } from '../../lib/facts';
import { look } from '../../lib/world/config';
import { motion, SWARM_CAM } from '../../lib/world/motion-config';

const { platforms, flags, mcpServers, skills, commands, agents } = facts;
const installCmd = './install.sh --all';
const platformFlags = new Set(platforms.map((p) => p.flag));
const otherFlags = flags.filter((f) => !platformFlags.has(f.flag));
const counts = [
  [agents.length, 'agents'],
  [skills.length, 'skills'],
  [mcpServers.length, 'MCP servers'],
  [commands.length, 'slash commands'],
] as const;
// Half the assembled text width as a fraction of the viewport height: the text is textWidth world units wide and the
// swarm camera sees viewH world units across the viewport height.
const viewH = 2 * SWARM_CAM.z * Math.tan((SWARM_CAM.fov * Math.PI) / 360);
const halfVh = ((look.particles.textWidth / 2) / viewH) * 100;
---
<section id="install" class="chapter" style={`--runway:${motion.runway.finale}; --cmd-half:${halfVh.toFixed(2)}vh`} aria-labelledby="install-title">
  <div class="scene" data-scene>
    <h2 id="install-title" class="sr-only">Install</h2>

    <div class="finale-cmd">
      <code class="install-cmd" data-install-cmd>{installCmd}</code>
      <div class="finale-copy" data-copy-wrap data-fx>
        <button type="button" class="btn" data-copy hidden>Copy</button>
        <span class="copy-status" role="status" data-copy-status></span>
      </div>
    </div>

    <div class="scene-foot finale-foot">
      <ul class="chips chips-center" aria-label="Installer platforms, flags and what it installs">
        {platforms.map((p) => <li class="chip" data-chip-in data-fx title={p.summary}>{p.name} {p.flag}</li>)}
        {counts.map(([n, label]) => <li class="chip" data-chip-in data-fx>{n} {label}</li>)}
        {otherFlags.map((f) => <li class="chip" data-chip-in data-fx title={f.description}>{f.flag}</li>)}
      </ul>
    </div>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const cmd = document.querySelector<HTMLElement>('[data-install-cmd]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (btn && cmd && status) {
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(cmd.textContent ?? '');
        status.textContent = 'Copied';
      } catch {
        status.textContent = 'Copy failed. Select the command in Reference.';
      }
      setTimeout(() => (status.textContent = ''), 2500);
    });
  }
</script>
