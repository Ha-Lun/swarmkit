---
import { motion } from '../../lib/world/motion-config';
---
<section id="top" class="chapter" style={`--runway:${motion.runway.intro}`} aria-labelledby="intro-title">
  <div class="scene" data-scene>
    <h1 id="intro-title" class="sr-only">SwarmKit</h1>
    <div class="scene-foot">
      <p class="caption motion-rise-late">A specialist agent swarm for Claude Code, OpenCode and Antigravity, built from one source.</p>
      <a href="#hive" class="cue">
        <span>Scroll</span>
        <svg class="motion-cue" width="12" height="18" viewBox="0 0 16 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M8 2v18M2 14l6 6 6-6" />
        </svg>
      </a>
    </div>
  </div>
</section>
