---
// Into the galaxy (homepage, beats 0-7). One fixed canvas, one sticky pin holding all copy as DOM. The copy and the
// worker labels are real elements; the client pins the labels to the projected 3D positions of the sun and the planets. Without scripting, WebGL or with reduced motion the sections stack as plain full-height compositions.
import '../../styles/galaxy.css';
import { loadFeaturedRun } from '../../lib/run.ts';
import { buildStory } from '../../lib/galaxy/story.ts';
import Numbers from './sections/Numbers.astro';
import Clis from './sections/Clis.astro';
import Cta from './sections/Cta.astro';

const run = loadFeaturedRun();
const story = run ? buildStory(run) : null;
const workers = story?.workers ?? [];
const fixers = workers.filter((w) => w.failed && w.fixer);
// verify fine print, derived: who failed a verify, and how each was fixed (a fixer branch, or a resume with no fixer)
const names = (xs: string[]): string => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}` : xs[0] ?? '');
const times = (n: number): string => (n === 1 ? 'once' : `${n} times`);
const byFixer = workers.filter((w) => w.failed && w.fixer);
const byResume = workers.filter((w) => w.failed && !w.fixer);
const closeUp = byFixer[0] ?? null; // the planet the camera flies to (same rule as system.ts)
const verifyNote = [
  ...byFixer.map((w) => `${w.slug} failed its tests ${times(w.failedVerifies)} and was fixed by the ${w.fixer!.lane} fixer ${w.fixer!.slug}.`),
  byResume.length > 0 ? `${names(byResume.map((w) => w.slug))} failed once each and were fixed on resume, with no fixer.` : '',
].filter(Boolean).join(' ');
const mergeLine = story
  ? `${story.counts.merges} merges · ${story.counts.reviews} reviews, ${story.counts.crossModelReviews} by a different model family`
  : '';
const task = run?.task ?? '';
const approval = run?.plan_approval;
const json = JSON.stringify({
  task,
  workers: workers.map((w) => ({
    slug: w.slug, lane: w.lane, launchIndex: w.launchIndex, buildIndex: w.buildIndex, failedVerifies: w.failedVerifies, resumes: w.resumes,
    failed: w.failed, fixer: w.fixer, reviewed: w.reviewed, reviewedBy: w.reviewedBy, mergeIndex: w.mergeIndex,
  })),
}).replace(/</g, '\\u003c');
---
<div class="gx" data-gx>
  <div class="gx-fallback" aria-hidden="true"></div>
  <canvas class="gx-canvas" data-gx-canvas aria-hidden="true"></canvas>

  <div class="gx-track" data-gx-track>
    <div class="gx-pin">
      <section class="gx-beat gx-hero" data-beat="hero" aria-labelledby="gx-title">
        <div class="gx-hero-inner" data-inner>
          <h1 id="gx-title" class="gx-title">One mind plans.<br />A swarm builds.</h1>
          <p class="gx-sub">Opus plans. Cheaper models build, in parallel. One config, three CLIs.</p>
          <p class="gx-actions">
            <a class="gx-btn gx-btn-primary" href="/#install">Install</a>
            <a class="gx-btn gx-btn-secondary" href="/how-it-works">How it works</a>
          </p>
        </div>
      </section>

      {task && (
        <section class="gx-beat gx-task" data-beat="task" aria-label="The task">
          <div class="gx-task-inner" data-inner>
            <p class="gx-kicker">Task</p>
            <p class="gx-task-line">
              <span class="gx-sr">{task}</span>
              <span aria-hidden="true"><span data-typed>{task}</span><span class="gx-rest" data-rest></span><span class="gx-caret"></span></span>
            </p>
            <p class="gx-cap">{run?.label}</p>
          </div>
        </section>
      )}

      <section class="gx-beat gx-plan" data-beat="plan" aria-labelledby="gx-plan-title">
        <div class="gx-plan-inner" data-inner>
          <p class="gx-kicker gx-num">01</p>
          <h2 id="gx-plan-title" class="gx-h2">Opus plans. You approve.</h2>
          <p class="gx-body">Plan mode on the strongest model. You approve before a single file changes.</p>
          <p class="gx-approved" data-approved>approved{approval ? ` (${approval})` : ''}</p>
        </div>
      </section>

      {story && (
        <>
          <section class="gx-beat gx-plan gx-late" data-beat="fan" aria-labelledby="gx-fan-title">
            <div class="gx-plan-inner" data-inner>
              <p class="gx-kicker gx-num">02</p>
              <h2 id="gx-fan-title" class="gx-h2">{story.counts.workers} workers. At once.</h2>
              <p class="gx-body">Cheaper models on OpenCode and Antigravity build in parallel.</p>
            </div>
          </section>
          <section class="gx-beat gx-plan gx-late" data-beat="build" aria-labelledby="gx-build-title">
            <div class="gx-plan-inner" data-inner>
              <p class="gx-kicker gx-num">03</p>
              <h2 id="gx-build-title" class="gx-h2">Each in its own worktree.</h2>
              <p class="gx-body">Isolated branches. Nothing touches main until it passes.</p>
            </div>
          </section>
          <section class="gx-beat gx-plan gx-late" data-beat="verify" aria-labelledby="gx-verify-title">
            <div class="gx-plan-inner" data-inner>
              <p class="gx-kicker gx-num">04</p>
              <h2 id="gx-verify-title" class="gx-h2">Tested. Reviewed. Fixed.</h2>
              <p class="gx-body">Every branch re-tested, reviewed by a different model. What failed got fixed.</p>
              {verifyNote && <p class="gx-cap gx-cap-note">{verifyNote}</p>}
              <p class="gx-cap gx-cap-run">{story.label}</p>
            </div>
          </section>
          {closeUp && (
            <section class="gx-beat gx-plan gx-late gx-cron" data-beat="cron" aria-labelledby="gx-cron-title">
              <div class="gx-plan-inner" data-inner>
                <p class="gx-kicker gx-num">04</p>
                <h2 id="gx-cron-title" class="gx-h2">Up close: {closeUp.slug}.</h2>
                <p class="gx-body">{closeUp.slug} failed its tests {times(closeUp.failedVerifies)}. The {closeUp.fixer!.lane} fixer {closeUp.fixer!.slug} fixed it, and it passed.</p>
              </div>
            </section>
          )}
          <section class="gx-beat gx-plan gx-late" data-beat="merge" aria-labelledby="gx-merge-title">
            <div class="gx-plan-inner" data-inner>
              <p class="gx-kicker gx-num">05</p>
              <h2 id="gx-merge-title" class="gx-h2">{story.verifyOk ? 'Merged. Green.' : 'Merged.'}</h2>
              <p class="gx-body">Opus merges what passed. {story.verifyOk ? 'One clean branch, final tests green.' : 'One clean branch.'} Everything lands as one.</p>
              <p class="gx-cap gx-cap-note">{mergeLine}</p>
              <p class="gx-cap gx-cap-run">{story.label}</p>
            </div>
          </section>
        </>
      )}

      <ul class="gx-nodes" data-nodes aria-label="Workers in this run">
        <li class="gx-node gx-node-opus" data-node><span class="gx-node-row"><span class="gx-node-slug">Opus</span><span class="gx-node-lane">planner</span></span></li>
        {workers.map((w) => (
          <li class={`gx-node gx-node-${w.lane}`} data-node>
            <span class="gx-node-row"><span class="gx-node-slug">{w.slug}</span><span class="gx-node-lane">{w.lane}</span></span>
            <span class="gx-node-tags">
              {w.failed && <span class="gx-tag gx-tag-fail" data-tag="fail">tests failed ×{w.failedVerifies}</span>}
              {w.failed && <span class="gx-tag gx-tag-fixed" data-tag="fixed">{w.fixer ? `fixed by ${w.fixer.slug}` : w.resumes > 0 ? 'fixed on resume' : 're-tested green'}</span>}
              {w.reviewed && <span class="gx-tag gx-tag-rev" data-tag="rev">{w.reviewedBy === 'cross-model' ? 'cross-model review' : 'reviewed'}</span>}
            </span>
          </li>
        ))}
        {fixers.map((w) => (
          <li class={`gx-node gx-node-${w.fixer!.lane} gx-node-fixer`} data-node>
            <span class="gx-node-row"><span class="gx-node-slug">{w.fixer!.slug}</span><span class="gx-node-lane">{w.fixer!.lane}</span></span>
            <span class="gx-node-tags"><span class="gx-tag gx-tag-fix" data-tag="fixer">fixer for {w.slug}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="gx-close" data-close-wrap>
    <Numbers />
    <Clis />
    <Cta />
  </div>
  <script type="application/json" id="gx-data" set:html={json} />
</div>

<script>
  import '../../components/galaxy/galaxy-client.ts';
</script>
