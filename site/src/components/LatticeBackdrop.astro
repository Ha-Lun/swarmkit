---
// Fallback backdrop: a top-down SVG of the lattice, generated at build time from layoutLattice (same layout the
// WebGL world uses). Shown only when html[data-tier="fallback"] (or without JS). Static: no animation, no accent.
import { facts } from '../lib/facts';
import { CELL_RADIUS } from '../lib/world/config';
import { layoutLattice } from '../lib/world/honeycomb';

const lat = layoutLattice(facts.agents);
const R = CELL_RADIUS;
const hex = (x: number, z: number) => {
  const pts = Array.from({ length: 6 }, (_, k) => {
    const a = (k * Math.PI) / 3; // pointy along z, like the extruded prisms
    return `${(x + R * Math.sin(a)).toFixed(2)} ${(z + R * Math.cos(a)).toFixed(2)}`;
  });
  return `M${pts.join('L')}Z`;
};
const agentPath = lat.cells.filter((c) => c.agent).map((c) => hex(c.x, c.z)).join('');
const fillerPath = lat.cells.filter((c) => !c.agent).map((c) => hex(c.x, c.z)).join('');
const xs = lat.cells.map((c) => c.x), zs = lat.cells.map((c) => c.z);
const pad = 2;
const [x0, x1, z0, z1] = [Math.min(...xs) - pad, Math.max(...xs) + pad, Math.min(...zs) - pad, Math.max(...zs) + pad];
---
<svg id="lattice-backdrop" viewBox={`${x0} ${z0} ${x1 - x0} ${z1 - z0}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <path d={fillerPath} class="filler" />
  <path d={agentPath} class="agent" />
</svg>
<noscript><style>#lattice-backdrop { display: block; }</style></noscript>
<style>
  #lattice-backdrop { display: none; position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: 0.5; }
  :global(html[data-tier='fallback']) #lattice-backdrop { display: block; }
  .filler { fill: none; stroke: var(--ink-2); stroke-width: 0.06; }
  .agent { fill: var(--ink-2); stroke: var(--wax-dim); stroke-width: 0.06; }
</style>
