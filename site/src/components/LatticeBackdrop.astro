---
// Fallback backdrop: an orthographic SVG of the globe, generated at build time from layoutLattice (same layout the
// WebGL world uses; the polygons are the real Goldberg cells, 12 of them pentagons). Shown only when
// html[data-tier="fallback"] (or without JS). Static: no animation, no accent.
import { facts } from '../lib/facts';
import { layoutLattice } from '../lib/world/honeycomb';

const lat = layoutLattice(facts.agents);
const R = lat.radius;
const TILT = (22 * Math.PI) / 180; // view from a little above, like the hive camera
const project = (p: { x: number; y: number; z: number }): [number, number, number] => {
  const y = p.y * Math.cos(TILT) - p.z * Math.sin(TILT);
  const z = p.y * Math.sin(TILT) + p.z * Math.cos(TILT);
  return [p.x * R, -y * R, z]; // svg y grows downwards
};
const facing = lat.cells.filter((c) => !c.moon && project(c.normal)[2] > 0.02);
const outline = (c: (typeof facing)[number]) =>
  `M${c.corners!.map((k) => project(k)).map(([x, y]) => `${x.toFixed(2)} ${y.toFixed(2)}`).join('L')}Z`;
const agentPath = facing.filter((c) => c.agent).map(outline).join('');
const fillerPath = facing.filter((c) => !c.agent).map(outline).join('');
const pad = R * 0.15;
const box = R + pad;
---
<svg id="lattice-backdrop" viewBox={`${-box} ${-box} ${2 * box} ${2 * box}`} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <circle r={R} class="limb" />
  <path d={fillerPath} class="filler" />
  <path d={agentPath} class="agent" />
</svg>
<noscript><style>#lattice-backdrop { display: block; }</style></noscript>
<style>
  #lattice-backdrop { display: none; position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: 0.5; }
  :global(html[data-tier='fallback']) #lattice-backdrop { display: block; }
  .limb { fill: none; stroke: var(--wax-dim); stroke-width: 0.05; }
  .filler { fill: none; stroke: var(--ink-2); stroke-width: 0.06; }
  .agent { fill: var(--ink-2); stroke: var(--wax-dim); stroke-width: 0.06; }
</style>
