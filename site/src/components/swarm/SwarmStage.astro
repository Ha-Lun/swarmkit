---
import { loadFeaturedRun } from '../../lib/run.ts';

const run = loadFeaturedRun();
const lanes = run ? run.workers.map((w) => w.lane) : ['opencode', 'agy', 'opencode', 'agy'];
---
<div class="swarm-stage">
  <div class="swarm-fallback" aria-hidden="true"></div>
  <canvas data-swarm-canvas data-lanes={JSON.stringify(lanes)} aria-hidden="true"></canvas>
</div>
<script>
  import './swarm-client.ts';
</script>
