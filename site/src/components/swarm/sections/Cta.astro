---
import { repoUrl } from '../../../lib/facts.ts';

const title = 'Put a swarm on your next task.';
const words = title.split(' ');
const dir = repoUrl.split('/').pop();
const lines = [`git clone ${repoUrl}.git`, `cd ${dir}`, './install.sh --all'];
---
<section data-beat="cta" id="install" aria-labelledby="swarm-cta-title">
  <div class="swarm-copy">
    <div class="swarm-copy-inner">
      <p class="swarm-kicker" data-swarm-fade>06</p>
      <h2 class="swarm-title swarm-title-beat" id="swarm-cta-title">{words.map((w, i) => (
        <>{i > 0 ? ' ' : ''}<span class="w"><span>{w}</span></span></>
      ))}</h2>
      <div class="swarm-install" data-swarm-fade>
        <pre><code id="swarm-install-code">{lines.join('\n')}</code></pre>
        <button type="button" class="swarm-install-copy" id="swarm-install-copy">Copy</button>
        <p class="swarm-status" id="swarm-install-status" role="status" aria-live="polite"></p>
      </div>
      <div class="swarm-actions" data-swarm-fade>
        <a class="swarm-btn swarm-btn-primary" href="/how-it-works">How it works in depth &rarr;</a>
        <a class="swarm-btn swarm-btn-secondary" href={repoUrl}>GitHub</a>
      </div>
      <p class="swarm-footer" data-swarm-fade>Hand-built. No AI-generated media.</p>
    </div>
  </div>
</section>
