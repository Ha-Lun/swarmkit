---
import { repoUrl } from '../../lib/facts';
---
<footer class="city-footer">
  <p class="city-footer-mark">SwarmKit</p>
  <p><a href={repoUrl}>{repoUrl.replace('https://', '')}</a></p>
  <p>This page was built with lead-dev-hybrid.</p>
  <p>The replay is one real run, not a median.</p>
</footer>

<style>
  /* Night palette: keep the footer dark (city.css pairs these tokens the other way). */
  .city-footer {
    background: var(--paper);
    color: var(--blueprint-ink);
  }
  .city-footer a {
    color: var(--blueprint-ink);
  }
</style>
