---
import { facts } from '../../../lib/facts';
import { roleLine } from '../../../lib/agents';
import type { Agent } from '../../../lib/agents';

const groups = new Map<string, Agent[]>();
for (const a of facts.agents) {
  const list = groups.get(a.pack);
  if (list) list.push(a);
  else groups.set(a.pack, [a]);
}
const others = [...groups.keys()].filter((p) => p !== 'core').sort((a, b) => a.localeCompare(b));
const districtNames = [...(groups.has('core') ? ['core'] : []), ...others];
const districts = districtNames.map((pack) => ({
  pack,
  agents: (groups.get(pack) ?? []).slice().sort((a, b) => a.name.localeCompare(b.name)),
}));

function tierClass(tier: string): string {
  if (tier === 'fast') return 'is-low';
  if (tier === 'deep') return 'is-tall';
  return 'is-mid';
}

function safeId(value: string): string {
  return value.toLowerCase().replace(/[^a-z0-9]+/g, '-');
}
---

<section id="roster" class="city-section" aria-labelledby="roster-title">
  <h2 id="roster-title">The roster, as a city map</h2>
  <p class="summary">{facts.agents.length} agents in {districts.length} districts.</p>
  <p class="lede">Packs are districts. Agents are buildings. Height is tier: low is fast, medium is standard, tall is deep. Hover, focus or tap a building for its role.</p>
  <div class="districts">
    {districts.map((d) => (
      <section class="district" aria-labelledby={`roster-district-${safeId(d.pack)}`}>
        <h3 id={`roster-district-${safeId(d.pack)}`} class="district-name">
          <span class="mono">{d.pack}</span>
          <span class="district-count">{d.agents.length} {d.agents.length === 1 ? 'agent' : 'agents'}</span>
        </h3>
        {d.pack === 'core' ? (
          <p class="district-note">core (always installed in Claude Code)</p>
        ) : d.pack === 'swarm' ? (
          <p class="district-note">pack: swarm (installed globally by install.sh --claude; install.sh --pack swarm is optional)</p>
        ) : (
          <p class="district-note">pack: {d.pack} (linked per project with install.sh --pack {d.pack})</p>
        )}
        <ul class="blocks">
          {d.agents.map((a) => (
            <li class:list={['building', tierClass(a.tier)]}>
              <button type="button" class="block" aria-describedby={`roster-desc-${safeId(a.name)}`}>
                <span class="block-name">{a.name}</span>
              </button>
              <span class="visually-hidden" id={`roster-desc-${safeId(a.name)}`}>{a.tier}: {roleLine(a)}</span>
              <div class="card" aria-hidden="true">
                <p class="card-name">{a.name}</p>
                <p class="card-tier">{a.tier}</p>
                <p class="card-role">{roleLine(a)}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="slot" aria-hidden="true">Hover, focus or tap a building.</p>
      </section>
    ))}
  </div>
</section>

<script>
  // Safari does not focus a button on tap; focus drives the card (:focus-within), so do it by hand.
  document.querySelectorAll<HTMLButtonElement>('#roster .block').forEach((b) => b.addEventListener('click', () => b.focus()));
</script>

<style>
  .summary {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .lede {
    max-width: 50rem;
  }
  .districts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .district {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--paper-2);
    color: var(--blueprint-ink);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .district-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.35;
  }
  .mono {
    font-family: var(--font-mono);
    font-weight: 400;
  }
  .district-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--blueprint-line-soft);
  }
  .district-note {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--blueprint-line-soft);
  }
  .blocks {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-2);
    margin: var(--space-4) 0 var(--space-4);
    padding: 0;
    list-style: none;
  }
  .building {
    width: 6.25rem;
  }
  .block {
    display: flex;
    align-items: flex-end;
    width: 100%;
    padding: var(--space-1) var(--space-2);
    background: var(--blueprint-ink);
    color: var(--paper);
    border: 1px solid var(--blueprint-line);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
  }
  .block:hover {
    background: color-mix(in srgb, var(--blueprint-ink) 72%, white);
  }
  .district .block:focus-visible {
    outline: 3px solid var(--light-warm);
    outline-offset: 2px;
  }
  .is-low .block {
    min-height: 3.5rem;
  }
  .is-mid .block {
    min-height: 5rem;
  }
  .is-tall .block {
    min-height: 6.5rem;
  }
  .block-name {
    overflow-wrap: break-word;
  }
  /* The reserved slot at the foot of each district: a hint at rest, the building's card on hover or focus.
     Cards are laid over the slot (not over the buildings) so they can never leave the district or the page. */
  .slot {
    box-sizing: border-box;
    height: 7.5rem;
    margin: auto 0 0;
    padding: var(--space-3);
    border: 1px dashed var(--blueprint-line-dim);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--blueprint-line-soft);
  }
  .card {
    position: absolute;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    height: 7.5rem;
    box-sizing: border-box;
    overflow: hidden;
    padding: var(--space-3);
    background: var(--paper);
    color: var(--blueprint-ink);
    border: 1px solid var(--blueprint-line);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .building:hover .card,
  .building:focus-within .card {
    opacity: 1;
    visibility: visible;
  }
  /* Hover wins over a leftover focus elsewhere in the same district. */
  .district:has(.building:hover) .building:not(:hover) .card {
    opacity: 0;
    visibility: hidden;
  }
  .card-name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .card-tier {
    margin: var(--space-1) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--blueprint-ink-2);
  }
  .card-role {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition: opacity 160ms ease;
    }
  }
  @media (max-width: 768px) {
    .districts {
      gap: var(--space-4);
    }
  }
  @media (max-width: 480px) {
    .districts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
