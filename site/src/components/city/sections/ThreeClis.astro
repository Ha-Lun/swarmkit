---
import { facts } from '../../../lib/facts';
---
<section id="three-clis" class="city-section" aria-labelledby="three-clis-title">
  <h2 id="three-clis-title">One source, three CLIs</h2>
  <div class="flow">
    <div class="source">
      <h3 class="source-title">core/</h3>
      <p class="source-counts">{facts.agents.length} agents, {facts.skills.length} skills, {facts.mcpServers.length} MCP servers</p>
    </div>
    <div class="pipe">
      <span class="pipe-arrow" aria-hidden="true"></span>
      <code class="pipe-label">scripts/build.py</code>
    </div>
    <ul class="targets">
      {facts.platforms.map((p) => (
        <li class="target">
          <h3 class="target-name">{p.name}</h3>
          <code class="target-flag">./install.sh {p.flag}</code>
          <p class="target-summary">{p.summary}</p>
        </li>
      ))}
    </ul>
  </div>
  <p class="note">Write an agent once; the compiler emits each CLI&rsquo;s native format and the installer links it into place.</p>
</section>

<style>
  .city-section {
    background: var(--paper);
    color: var(--blueprint-ink);
    padding: var(--space-16) var(--space-6);
  }

  .city-section h2 {
    margin: 0 0 var(--space-8);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    max-width: 40rem;
    margin-inline: auto;
  }

  .flow {
    display: flex;
    align-items: stretch;
    gap: var(--space-4);
    max-width: 64rem;
    margin-inline: auto;
  }

  .source {
    flex: 0 0 16rem;
    align-self: center;
    background: var(--blueprint-ink);
    color: var(--paper);
    border: 1px solid var(--blueprint-ink-2);
    padding: var(--space-4);
  }

  .source-title {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .source-counts {
    margin: var(--space-2) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--blueprint-line-soft);
  }

  .pipe {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 9rem;
  }

  .pipe-arrow {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--blueprint-line);
    position: relative;
  }

  .pipe-arrow::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 10px;
    height: 10px;
    border-top: 2px solid var(--blueprint-line);
    border-right: 2px solid var(--blueprint-line);
    transform: translateY(-50%) rotate(45deg);
  }

  .pipe-label {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.3;
    color: var(--blueprint-ink);
    white-space: nowrap;
  }

  .targets {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .target {
    background: var(--blueprint-ink);
    color: var(--paper);
    border: 1px solid var(--blueprint-ink-2);
    border-top: 3px solid var(--blueprint-line);
    padding: var(--space-4);
  }

  .target-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    line-height: 1.3;
  }

  .target-flag {
    display: inline-block;
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border: 1px solid var(--blueprint-line);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.3;
    white-space: nowrap;
  }

  .target-summary {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    color: var(--blueprint-line-soft);
  }

  .note {
    max-width: 64rem;
    margin: var(--space-6) auto 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }

  @media (max-width: 1024px) {
    .targets {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .source {
      flex-basis: 13rem;
    }
  }

  @media (max-width: 768px) {
    .flow {
      flex-direction: column;
    }

    .source {
      flex: none;
      align-self: stretch;
    }

    .pipe {
      min-width: 0;
      padding: var(--space-2) 0;
    }

    .pipe-arrow {
      width: 2px;
      height: 2.5rem;
    }

    .pipe-arrow::after {
      right: auto;
      left: 50%;
      top: auto;
      bottom: 0;
      transform: translateX(-50%) rotate(135deg);
    }

    .targets {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 390px) {
    .city-section {
      padding: var(--space-12) var(--space-4);
    }

    .target-flag {
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }
</style>
