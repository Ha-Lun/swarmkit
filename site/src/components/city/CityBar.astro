---
// Slim top bar for /city only. Hidden while the pinned stage is on screen (so the hero title stays the LCP element and
// nothing covers the scene), shown once the stage has been scrolled past. Links are to the section ids; the repo link
// comes from facts. Without scripting the bar is a static strip (see city.css).
import { repoUrl } from '../../lib/facts';

const links = [
  { id: 'which-mode', label: 'Modes' },
  { id: 'numbers', label: 'Numbers' },
  { id: 'three-clis', label: 'CLIs' },
  { id: 'roster', label: 'Roster' },
  { id: 'safety', label: 'Safety' },
  { id: 'install', label: 'Install' },
  { id: 'build-log', label: 'Build log' },
];
---
<header class="city-bar" data-city-bar>
  <a class="city-bar-mark" href="#top">SwarmKit</a>
  <nav class="city-bar-nav" aria-label="Sections">
    <ul class="city-bar-links">
      {links.map((l) => <li><a href={`#${l.id}`}>{l.label}</a></li>)}
    </ul>
  </nav>
  <a class="city-bar-repo" href={repoUrl}>GitHub</a>
</header>

<script>
  const bar = document.querySelector<HTMLElement>('[data-city-bar]');
  // The stage, or the "replay pending" panel that stands in for it.
  const stage = document.querySelector('[data-city-stage], .city-pending');
  if (bar && stage) {
    // Visible once the stage has been scrolled past: its bottom edge is above the top quarter of the viewport (the
    // margin keeps the bar on after an anchor jump, which parks the next section just under the top).
    const io = new IntersectionObserver((entries) => {
      const e = entries[entries.length - 1]; // the latest state wins when callbacks are batched
      bar.classList.toggle('is-on', !e.isIntersecting && e.boundingClientRect.bottom < innerHeight / 2);
    }, { rootMargin: '-25% 0px 0px 0px' });
    io.observe(stage);
  }
</script>
