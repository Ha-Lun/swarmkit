---
// The one fixed canvas island. The canvas element itself is created by mount.ts after first paint, so the DOM
// text stays the LCP element. Fallback tier: no canvas, no intro, the SVG backdrop instead.
import { facts } from '../lib/facts';
import { examples, gates } from '../content/routing';
import LatticeBackdrop from './LatticeBackdrop.astro';

const gateNames: string[] = gates.map((g) => g.agent);
const specialist = examples.find((e) => e.tier === 'T2')?.route.find((r) => r.agent && r.agent !== 'explore' && !gateNames.includes(r.agent))?.agent;
const mainTier = examples.find((e) => e.tier === 'T2')?.tier;
const data = { agents: facts.agents, routing: { gates: gateNames, specialist, mainTier } };
---
<LatticeBackdrop />
<div id="world-root" aria-hidden="true"></div>
<script id="world-data" type="application/json" set:html={JSON.stringify(data)} />
<script>
  import { decideTier, markTier } from '../lib/world/tiers';

  const boot = () => {
    const decision = decideTier();
    if (decision.tier === 'fallback') {
      markTier('fallback', decision.reason);
      document.documentElement.dataset.world = 'fallback';
      return;
    }
    const { agents, routing } = JSON.parse(document.getElementById('world-data')!.textContent!);
    import('../lib/world/mount').then((m) => m.mountWorld(decision, agents, routing));
  };
  const schedule = () => ('requestIdleCallback' in window ? requestIdleCallback(boot, { timeout: 1500 }) : setTimeout(boot, 300));
  if (document.readyState === 'complete') schedule();
  else window.addEventListener('load', schedule, { once: true });
</script>
