---
import Base from '../layouts/Base.astro';
import GalaxyBar from '../components/galaxy/GalaxyBar.astro';
import GalaxyStage from '../components/galaxy/GalaxyStage.astro';
---
<Base
  title="SwarmKit: one mind plans, a swarm builds"
  description="A scroll-driven flight into a galaxy of code: Opus plans, cheaper models build in parallel, every branch tested and reviewed before it merges. One config for Claude Code, OpenCode and Antigravity."
  imageAlt="A spiral galaxy of teal and amber stars around a bright violet-white core, rendered live in WebGL: the SwarmKit galaxy, where each worker is a star."
>
  <GalaxyBar slot="top" />
  <GalaxyStage />
</Base>
