---
import { loadAgents } from '../lib/agents';
const agents = loadAgents();
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>previs</title>
    <style>
      html, body { margin: 0; height: 100%; background: #0d0e10; color: #cfcfcf; font: 12px/1.4 ui-monospace, monospace; }
      canvas { position: fixed; inset: 0; width: 100vw; height: 100vh; display: block; }
      #hud { position: fixed; left: 12px; right: 12px; bottom: 12px; display: grid; gap: 4px; z-index: 1; }
      #hud input { width: 100%; }
      #readout { white-space: pre; }
    </style>
  </head>
  <body>
    <canvas id="c"></canvas>
    <div id="hud">
      <input id="slider" type="range" min="0" max="1" step="0.001" value="0" aria-label="globalProgress" />
      <div id="readout"></div>
    </div>
    <script id="agents-data" type="application/json" set:html={JSON.stringify(agents)} />
    <script>
      import { createWorld, type SharedState } from '../lib/world/previs-world';
      import { chapterAt, SEGMENTS } from '../lib/world/camera-path';
      import type { Agent } from '../lib/agents';

      const agents: Agent[] = JSON.parse(document.getElementById('agents-data')!.textContent!);
      const state: SharedState = { globalProgress: Number(new URLSearchParams(location.search).get('p') ?? 0) };
      const slider = document.getElementById('slider') as HTMLInputElement;
      const out = document.getElementById('readout')!;
      const canvas = document.getElementById('c') as HTMLCanvasElement;
      slider.value = String(state.globalProgress);
      slider.addEventListener('input', () => (state.globalProgress = Number(slider.value)));

      const frames: number[] = [];
      let recent: number[] = [];
      let sweepResult = '';
      const world = createWorld(canvas, state, agents, {
        onFrame: (dt) => { frames.push(dt); recent.push(dt); if (recent.length > 60) recent.shift(); },
      });

      const median = (a: number[]) => [...a].sort((x, y) => x - y)[Math.floor(a.length / 2)];
      const gl = canvas.getContext('webgl2');
      const dbg = gl?.getExtension('WEBGL_debug_renderer_info');
      const renderer = gl && dbg ? gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) : 'unknown';

      function paint() {
        const { chapter, chapterProgress } = chapterAt(state.globalProgress);
        const fps = recent.length ? 1000 / (recent.reduce((s, v) => s + v, 0) / recent.length) : 0;
        out.textContent =
          `globalProgress ${state.globalProgress.toFixed(3)}   chapter ${chapter} (${SEGMENTS[chapter].name})   chapterProgress ${chapterProgress.toFixed(3)}\n` +
          `fps ${fps.toFixed(1)}   agent cells ${world.agentCount} / agents ${agents.length}   renderer ${renderer}` +
          (sweepResult ? `\n${sweepResult}` : '');
        requestAnimationFrame(paint);
      }
      paint();

      if (new URLSearchParams(location.search).get('sweep') === '1') {
        const t0 = performance.now();
        const DURATION = 20000;
        (function step(now: number) {
          const t = Math.min(1, (now - t0) / DURATION);
          state.globalProgress = t;
          slider.value = String(t);
          if (t < 1) return void requestAnimationFrame(step);
          // frames[] covers the whole sweep (nothing else ran before it besides load)
          const fpsList = frames.map((d) => 1000 / d);
          const min = Math.min(...fpsList), med = median(fpsList);
          sweepResult = `SWEEP DONE frames=${frames.length} minFps=${min.toFixed(1)} medianFps=${med.toFixed(1)}`;
          console.log(sweepResult);
          (window as any).__sweep = { frames: frames.length, minFps: min, medianFps: med, renderer };
        })(t0);
      }
      window.addEventListener('pagehide', () => world.dispose());
    </script>
  </body>
</html>
