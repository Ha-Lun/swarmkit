---
// In-depth page: the scroll-scrubbed City replay of one real run, then the technical sections. The showcase is /.
import Base from '../layouts/Base.astro';
import CityStage from '../components/city/CityStage.astro';
import RunResult from '../components/city/sections/RunResult.astro';
import CityBar from '../components/city/CityBar.astro';
import CityFooter from '../components/city/CityFooter.astro';
import WhichMode from '../components/city/sections/WhichMode.astro';
import Numbers from '../components/city/sections/Numbers.astro';
import ThreeClis from '../components/city/sections/ThreeClis.astro';
import RosterMap from '../components/city/sections/RosterMap.astro';
import Safety from '../components/city/sections/Safety.astro';
import Install from '../components/city/sections/Install.astro';
import BuildLog from '../components/city/sections/BuildLog.astro';
---
<Base title="How SwarmKit works: one real run, replayed" description="One real lead-dev-hybrid run replayed as a miniature city, plus modes, benchmarks, the three CLIs, the roster, safety and install.">
  <CityBar slot="top" />
  <span id="top"></span>
  <CityStage />
  <RunResult />
  <WhichMode />
  <Numbers />
  <ThreeClis />
  <RosterMap />
  <Safety />
  <Install />
  <BuildLog />
  <CityFooter slot="bottom" />
</Base>
