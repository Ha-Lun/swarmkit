#!/usr/bin/env python3
"""Run one agy (or OpenCode) task headlessly in an isolated git worktree and report honestly.

  agy-task start  SLUG [--model M] [--effort E] [--timeout 20m] [--base REF] [--setup CMD] [--review] [--yolo] [--wait] PROMPT|-
  agy-task resume SLUG [--timeout 20m] [--review] [--yolo] PROMPT|-
  agy-task list
  agy-task clean  SLUG [--force]

--review is for tasks that answer in text: ok then means "no tool denied and a non-empty
response", not "files changed". --setup CMD runs in the worktree before agy (e.g. installing
or linking dependencies; a fresh worktree has tracked files only). At most $AGY_TASK_MAX
(default 3) tasks run at once; --wait queues for a free slot instead of refusing.
Edit-only by default: agy can read and edit files but shell commands are denied, so run
tests yourself on the branch. --yolo auto-approves every tool and is NOT sandboxed (agy
can then write outside the worktree and reach the network); use it only for trusted work.
Everything lands under $AGY_TASK_DIR (default ~/.agy-tasks/<repo>/<slug>): the worktree,
result.json and agy.log. agy's own "status" is SUCCESS even when tools were denied, so
result.json carries a recomputed "ok".

Invoked as opencode-task (a symlink) it drives `opencode run`: branches opencode/<slug>, tasks under
$OPENCODE_TASK_DIR (default ~/.opencode-tasks). A per-run config overlay (OPENCODE_CONFIG_CONTENT, this
process only) allows edits, limits the shell to test/build runners and read-only git, and turns off
subagents; the user's own OpenCode config is untouched. --yolo lifts the shell limit (not sandboxed).

The running-task limit is shared: agy and opencode tasks together never exceed it (the limit
itself is read from the invoked backend's *_TASK_MAX).
"""
import argparse, fcntl, hashlib, json, os, re, shutil, signal, subprocess, sys, time
from pathlib import Path

# opencode-task is a symlink to this file; the name picks the backend
PROG = "opencode-task" if Path(sys.argv[0]).name == "opencode-task" else "agy-task"


def seconds(s):
    return int(s[:-1]) * {"s": 1, "m": 60, "h": 3600}[s[-1]] if s[-1] in "smh" else int(s)


def agy_cmd(task, prompt, a, resume_id):
    cmd = ["agy", "-p", prompt, "--output-format", "json", "--mode", "accept-edits",
           "--print-timeout", f"{seconds(a.timeout)}s"]
    if resume_id:
        cmd += ["--conversation", resume_id]
    else:
        cmd += ["--model", a.model] + (["--effort", a.effort] if a.effort else [])
    if a.yolo:
        cmd.append("--dangerously-skip-permissions")
        print("agy-task: --yolo, agy is unsandboxed", file=sys.stderr)
    return cmd


def agy_parse(out, err):
    try:
        res = json.loads(out)
    except ValueError:
        res = {}
    return {"done": res.get("status") == "SUCCESS", "conversation_id": res.get("conversation_id"),
            "usage": res.get("usage"), "response": res.get("response", ""),
            "denied": [d.get("display_name", d.get("action")) for d in res.get("denied_actions", [])],
            # agy exits 0 with partial output when its own timeout hits
            "timed_out": bool(re.search(r"print timeout", err))}


def remembered_opts(task, a, resume_id):
    """Model and effort of the first run: opencode forgets them on resume."""
    f = task / "opts.json"
    if resume_id:
        return json.loads(f.read_text()) if f.exists() else {}
    o = {"model": a.model, "effort": a.effort}
    f.write_text(json.dumps(o))
    return o


# Applied only to the delegated run (OPENCODE_CONFIG_CONTENT), so the user's own OpenCode config is
# untouched: edits allowed, the shell limited to common test/build runners and read-only git, no subagents.
# A guard against accidents, not a sandbox: a test runner executes code the worker can write itself.
RUNNERS = ("npm test", "npm run test", "npm run lint", "npm run build", "npm run typecheck", "pnpm test",
           "pnpm run test", "pnpm run lint", "pnpm run build", "yarn test", "yarn lint", "yarn build",
           "bun test", "python3 -m pytest", "python -m pytest", "pytest", "python3 -m unittest",
           "python -m unittest", "go test", "go vet", "cargo test", "cargo check", "make test",
           "node --test", "node test.js", "node --version", "git status", "git diff", "git log", "git show")
# Patterns that need their own shape (the loop below only adds "<cmd>" and "<cmd> *"): plain-node and
# plain-python test files (not `python3 *`: that runs arbitrary code), and the read-only commands models
# reach for to look around (ls, pwd, echo, wc for line counts, cat of source and test paths only, so
# `cat .env` stays denied). Not `cd`: the worker already starts in the worktree, and
# `cd <elsewhere> && npm test` would test a different checkout.
RUNNER_GLOBS = ("node test/*", "node tests/*", "node __tests__/*", "python3 test/*", "python3 tests/*",
                "pwd", "ls", "ls *", "echo *", "wc *",
                "cat src/*", "cat test/*", "cat tests/*", "cat package.json", "cat README.md")
OPENCODE_OVERLAY = {
    "permission": {
        "edit": "allow", "webfetch": "deny", "task": "deny",
        "bash": {"*": "deny", **{p: "allow" for c in RUNNERS for p in (c, c + " *")},
                 **{g: "allow" for g in RUNNER_GLOBS}},
    },
}


def opencode_cmd(task, prompt, a, resume_id):
    o = remembered_opts(task, a, resume_id)
    if a.yolo:
        print("opencode-task: --yolo, the shell is unrestricted and unsandboxed", file=sys.stderr)
    # --standalone: a private server started with our env (and so the overlay). The shared background
    # service would apply the user's own config.
    cmd = ["opencode", "run", "--standalone", "--format", "json", "--agent", "build",
           "--title", f"delegate: {task.name}"] + (["-s", resume_id] if resume_id else [])
    if o.get("model"):
        cmd += ["-m", o["model"] + (f"#{o['effort']}" if o.get("effort") else "")]
    return cmd + ["--", prompt]


def opencode_env(a, wt):
    perm = dict(OPENCODE_OVERLAY["permission"])
    if a.yolo:
        perm["bash"] = "allow"
    if a.review:  # a review answers in text and must not edit
        perm["edit"] = "deny"
    # opencode takes its project directory from $PWD, not the real cwd: without this it edits the
    # checkout agy-task was started from instead of the worktree.
    return {**os.environ, "PWD": str(wt), "OPENCODE_CONFIG_CONTENT": json.dumps({"permission": perm})}


def opencode_parse(out, err):
    r = {"done": False, "conversation_id": None, "usage": None, "response": "", "denied": [],
         "timed_out": False}
    failed, usage = False, {}  # failed: an error with no finished step after it (retries can recover)
    for line in out.splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        t, part = e.get("type"), e.get("part") or {}
        r["conversation_id"] = r["conversation_id"] or e.get("sessionID")
        if t == "error":
            failed = True
        elif t == "text" and part.get("text", "").strip():
            r["response"] = part["text"]
        elif t == "step_finish":
            r["done"], failed = True, False
            tok = part.get("tokens") or {}
            for k in ("input", "output", "reasoning"):
                usage[k] = usage.get(k, 0) + tok.get(k, 0)
            usage["cache_read"] = usage.get("cache_read", 0) + (tok.get("cache") or {}).get("read", 0)
        elif t == "tool_use":
            st = part.get("state") or {}
            if st.get("status") == "error" and re.search(r"rule which prevents|permission|rejected",
                                                         str(st.get("error", "")), re.I):
                inp = st.get("input") or {}
                r["denied"].append(inp.get("command") or part.get("tool", "tool"))
    r["done"] = r["done"] and not failed
    r["usage"] = usage or None
    return r


BACKENDS = {
    "agy-task": {"cli": "agy", "env": "AGY_TASK", "home": ".agy-tasks",
                 "model": "gemini-3.8-flash-high", "cmd": agy_cmd, "parse": agy_parse, "grace": 30},
    "opencode-task": {"cli": "opencode", "env": "OPENCODE_TASK", "home": ".opencode-tasks",
                      "model": "opencode-go/cat-jam-free", "effort": "max", "cmd": opencode_cmd,
                      "parse": opencode_parse, "grace": 0, "proc_env": opencode_env},
}
BACKEND = BACKENDS[PROG]
CLI = BACKEND["cli"]


def alive(pidfile):
    try:
        pid = int(pidfile.read_text())
        os.kill(pid, 0)
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
        return any(name.encode() in cmdline for name in BACKENDS)  # not a recycled pid
    except (OSError, ValueError):
        return False


def sh(*cmd, cwd=None, check=True):
    p = subprocess.run(cmd, cwd=cwd, text=True, capture_output=True)
    if check and p.returncode:
        sys.exit(f"{PROG}: {' '.join(cmd[:3])} failed: {p.stderr.strip() or p.stdout.strip()}")
    return p.stdout.strip()


def spec(task):
    """Pathspec for the worktree: everything except what --setup created."""
    f = task / "setup-artifacts"
    return ["--", ".", *[f":(exclude){x}" for x in (f.read_text().split("\n") if f.exists() else []) if x]]


def main_state(repo):
    """Changed and untracked paths of the main checkout, with a content hash for each."""
    out = subprocess.run(["git", "status", "--porcelain", "-uall", "-z"], cwd=repo, text=True,
                         capture_output=True).stdout  # not sh(): stripping would eat the status column
    state, fields = {}, iter(out.split("\0"))
    for entry in fields:
        if not entry:
            continue
        if entry[0] in "RC":  # a rename or copy is followed by its source path
            next(fields, None)
        f = repo / entry[3:]
        state[entry[3:]] = hashlib.sha1(f.read_bytes()).hexdigest() if f.is_file() else entry[:2]
    return state


def run_task(task, prompt, a, repo, resume_id=None, warnings=()):
    wt = task / "worktree"
    (task / "pid").write_text(str(os.getpid()))
    cmd = BACKEND["cmd"](task, prompt, a, resume_id)
    main_before = main_state(repo)
    # Own process group so a SIGTERM/SIGINT to us (or a timeout) takes the agent and its tools down too.
    env = BACKEND["proc_env"](a, wt) if "proc_env" in BACKEND else None
    p = subprocess.Popen(cmd, cwd=wt, env=env, text=True, stdin=subprocess.DEVNULL, start_new_session=True,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    interrupted = []

    def stop(signum=None, frame=None):
        interrupted.append(signum or "timeout")
        try:
            os.killpg(p.pid, signal.SIGTERM)
        except OSError:
            pass
    def reap(p):  # SIGTERM was sent; escalate if the agent or a tool ignores it
        try:
            return p.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                pass
            return p.communicate(timeout=10)
    old = [signal.signal(sig, stop) for sig in (signal.SIGTERM, signal.SIGINT)]
    try:
        out, err = p.communicate(timeout=seconds(a.timeout) + BACKEND["grace"])
    except subprocess.TimeoutExpired:
        stop()
        out, err = reap(p)
    finally:
        for sig, h in zip((signal.SIGTERM, signal.SIGINT), old):
            signal.signal(sig, h)
    code = p.returncode
    if interrupted:
        try:
            os.killpg(p.pid, signal.SIGKILL)  # stragglers from the process group
        except OSError:
            pass
    (task / "pid").unlink(missing_ok=True)
    (task / f"{CLI}.log").write_text(f"{err}\n{out}")
    res = BACKEND["parse"](out, err)
    warnings = list(warnings)
    after = main_state(repo)
    moved = sorted(k for k in main_before.keys() | after.keys() if main_before.get(k) != after.get(k))
    if moved:  # advisory: you may have edited or merged there yourself meanwhile
        warnings.append(f"main checkout changed during the run, not by you? {', '.join(moved[:5])}")
    if interrupted:
        warnings.append(f"interrupted: {CLI} was stopped before it finished")
    if res["timed_out"]:
        warnings.append("timed out: the response and edits may be incomplete")
    try:  # never lose the agent's work to a hook or signing failure
        sh("git", "add", "-A", *spec(task), cwd=wt)
        if subprocess.run(["git", "diff", "--cached", "--quiet"], cwd=wt).returncode:
            sh("git", "-c", "commit.gpgsign=false", "commit", "--no-verify", "-qm", f"{CLI}: {task.name}", cwd=wt)
    except SystemExit as e:
        warnings.append(f"commit failed, changes are uncommitted in the worktree: {e}")
    base = (task / "base").read_text().strip()
    changed = sh("git", "diff", "--shortstat", base, "HEAD", cwd=wt, check=False) or "no changes"
    if changed == "no changes" and sh("git", "status", "--porcelain", *spec(task), cwd=wt, check=False):
        changed = "uncommitted changes"
    denied = res["denied"]
    review = a.review
    incomplete = any(w.startswith(("interrupted", "timed out", "commit failed")) for w in warnings)
    produced = bool(res["response"].strip()) if review else changed != "no changes"
    ok = res["done"] and not denied and code == 0 and not incomplete and produced
    result = {"ok": ok, "slug": task.name, "branch": f"{CLI}/{task.name}", "worktree": str(wt), "review": review,
              "base": base, "changes": changed, "denied_actions": denied, "warnings": warnings,
              "conversation_id": res["conversation_id"], "exit_code": code, "usage": res["usage"],
              "response": res["response"], "stderr": err.strip()[-500:]}
    (task / "result.json").write_text(json.dumps(result, indent=2))
    hint = " (resume it: use file view/edit tools only, no shell)" if CLI == "agy" else ""
    note = (f" DENIED: {', '.join(denied)}{hint}" if denied else "") \
        + "".join(f" WARNING: {w}" for w in warnings)
    print(f"{PROG} {task.name}: {'ok' if ok else 'NOT ok'} ({changed}){note} -> {task}/result.json")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawTextHelpFormatter)
    ap.add_argument("cmd", choices=["start", "resume", "list", "clean"])
    ap.add_argument("slug", nargs="?")
    ap.add_argument("prompt", nargs="?", help="task text, or - to read it from stdin")
    ap.add_argument("--model", default=BACKEND["model"])
    ap.add_argument("--effort", default=BACKEND.get("effort"))
    ap.add_argument("--timeout", default="20m")
    ap.add_argument("--base", default="HEAD")
    ap.add_argument("--setup", help="shell command run in the worktree before agy (start only)")
    ap.add_argument("--review", action="store_true")
    ap.add_argument("--yolo", action="store_true")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--wait", action="store_true", help="queue for a free slot instead of refusing at the limit")
    a = ap.parse_args()

    # The first `git worktree list` entry is the main working tree, also when run from inside a
    # task worktree or a submodule: it keys the task dirs, so every worktree shares one list and cap.
    # `here` is the checkout we were invoked from: HEAD (default base, merged check) means its HEAD.
    repo = Path(sh("git", "worktree", "list", "--porcelain").splitlines()[0].split(" ", 1)[1])
    here = Path(sh("git", "rev-parse", "--show-toplevel"))
    key = f"{repo.name}-{hashlib.sha1(str(repo).encode()).hexdigest()[:6]}"
    def home(b):
        return Path(os.environ.get(f"{b['env']}_DIR", Path.home() / b["home"])) / key
    root = home(BACKEND)
    if a.cmd == "list":
        for d in sorted(root.glob("*/")) if root.exists() else []:
            r = json.loads((d / "result.json").read_text()) if (d / "result.json").exists() else {}
            state = "running" if alive(d / "pid") else ("ok" if r.get("ok") else "NOT ok" if r else "unfinished")
            print(f"{d.name:24} {state:10} {r.get('changes', '')}")
        return 0
    if not a.slug or not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,40}", a.slug):
        sys.exit(f"{PROG}: slug must be lowercase letters, digits, . _ - (max 41 chars)")
    task, branch = root / a.slug, f"{CLI}/{a.slug}"

    if a.cmd == "clean":
        wt = task / "worktree"
        merged = subprocess.run(["git", "merge-base", "--is-ancestor", branch, "HEAD"], cwd=here).returncode == 0
        if not a.force:
            if wt.exists() and sh("git", "status", "--porcelain", *spec(task), cwd=wt, check=False):
                sys.exit(f"{PROG}: {wt} has uncommitted changes; inspect them or pass --force to discard")
            if not merged:
                sys.exit(f"{PROG}: {branch} is not merged into HEAD; merge it or pass --force to discard")
        sh("git", "worktree", "remove", "--force", str(wt), cwd=repo, check=False)
        shutil.rmtree(task, ignore_errors=True)
        sh("git", "worktree", "prune", cwd=repo, check=False)
        sh("git", "branch", "-D", branch, cwd=repo, check=False)
        return 0

    # One limit for all backends: they share the box. The lock makes check-and-claim atomic, so queued
    # --wait callers cannot all see the same free slot; the claim is the pid file written below.
    cap = int(os.environ.get(f"{BACKEND['env']}_MAX", 3))
    lock = open(Path.home() / ".swarmkit-task.lock", "a")
    while True:
        fcntl.flock(lock, fcntl.LOCK_EX)
        running = [f for b in BACKENDS.values() for f in home(b).glob("*/pid") if alive(f)]
        if len(running) < cap:
            break
        fcntl.flock(lock, fcntl.LOCK_UN)
        if not a.wait:
            sys.exit(f"{PROG}: {len(running)} delegated tasks already running (all backends); wait for one, or pass --wait")
        time.sleep(10)
    def claim(task):
        (task / "pid").write_text(str(os.getpid()))
        fcntl.flock(lock, fcntl.LOCK_UN)
    prompt = sys.stdin.read() if a.prompt == "-" else a.prompt
    if not prompt:
        sys.exit(f"{PROG}: a prompt (or -) is required")
    if a.cmd == "start":
        if task.exists():
            sys.exit(f"{PROG}: {task} exists; pick another slug or run clean")
        try:
            task.mkdir(parents=True)
        except FileExistsError:
            sys.exit(f"{PROG}: {task} exists; pick another slug or run clean")
        claim(task)
        base = sh("git", "rev-parse", a.base, cwd=here)
        (task / "base").write_text(base)
        try:
            sh("git", "worktree", "add", "-q", "-b", branch, str(task / "worktree"), base, cwd=repo)
        except SystemExit:
            for f in task.iterdir():
                f.unlink()
            task.rmdir()
            raise
        dirty = sh("git", "status", "--porcelain", "--untracked-files=no", cwd=here)
        warn = [f"{here} has uncommitted changes; {CLI} sees only the committed state "
                f"of {a.base}"] if dirty and a.base == "HEAD" else []
        for w in warn:
            print(f"{PROG}: WARNING: {w}", file=sys.stderr)
        if a.setup:
            wt = task / "worktree"
            sh("sh", "-c", a.setup, cwd=wt)
            # Keep setup artifacts (e.g. a node_modules link) out of agy's commit. Not info/exclude:
            # that file is shared with the main checkout.
            (task / "setup-artifacts").write_text(
                sh("git", "ls-files", "--others", "--exclude-standard", "--directory", cwd=wt))
        return run_task(task, prompt, a, repo, warnings=warn)
    if alive(task / "pid"):
        sys.exit(f"{PROG}: {a.slug} is still running; wait for it before resuming")
    if not (task / "result.json").exists():
        sys.exit(f"{PROG}: no finished run for {a.slug} to resume")
    prev = json.loads((task / "result.json").read_text())
    if not prev.get("conversation_id"):
        sys.exit(f"{PROG}: previous run has no conversation_id to resume")
    a.review = a.review or prev.get("review", False)  # a resumed review stays a review
    claim(task)
    return run_task(task, prompt, a, repo, prev["conversation_id"])


if __name__ == "__main__":
    sys.exit(main())
