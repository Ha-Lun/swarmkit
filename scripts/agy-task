#!/usr/bin/env python3
"""Run one agy task headlessly in an isolated git worktree and report honestly.

  agy-task start  SLUG [--model M] [--effort E] [--timeout 20m] [--base REF] [--setup CMD] [--review] [--yolo] PROMPT|-
  agy-task resume SLUG [--timeout 20m] [--review] [--yolo] PROMPT|-
  agy-task list
  agy-task clean  SLUG [--force]

--review is for tasks that answer in text: ok then means "no tool denied and a non-empty
response", not "files changed". --setup CMD runs in the worktree before agy (e.g. installing
or linking dependencies; a fresh worktree has tracked files only). At most $AGY_TASK_MAX
(default 3) tasks run at once.
Edit-only by default: agy can read and edit files but shell commands are denied, so run
tests yourself on the branch. --yolo auto-approves every tool and is NOT sandboxed (agy
can then write outside the worktree and reach the network); use it only for trusted work.
Everything lands under $AGY_TASK_DIR (default ~/.agy-tasks/<repo>/<slug>): the worktree,
result.json and agy.log. agy's own "status" is SUCCESS even when tools were denied, so
result.json carries a recomputed "ok".
"""
import argparse, json, os, re, signal, subprocess, sys
from pathlib import Path


def alive(pidfile):
    try:
        os.kill(int(pidfile.read_text()), 0)
        return True
    except (OSError, ValueError):
        return False


def sh(*cmd, cwd=None, check=True):
    p = subprocess.run(cmd, cwd=cwd, text=True, capture_output=True)
    if check and p.returncode:
        sys.exit(f"agy-task: {' '.join(cmd[:3])} failed: {p.stderr.strip() or p.stdout.strip()}")
    return p.stdout.strip()


def seconds(s):
    return int(s[:-1]) * {"s": 1, "m": 60, "h": 3600}[s[-1]] if s[-1] in "smh" else int(s)


def run_agy(task, prompt, a, resume_id=None, warnings=()):
    wt = task / "worktree"
    (task / "pid").write_text(str(os.getpid()))
    cmd = ["agy", "-p", prompt, "--output-format", "json", "--mode", "accept-edits",
           "--print-timeout", f"{seconds(a.timeout)}s"]
    if resume_id:
        cmd += ["--conversation", resume_id]
    else:
        cmd += ["--model", a.model] + (["--effort", a.effort] if a.effort else [])
    if a.yolo:
        cmd.append("--dangerously-skip-permissions")
        print("agy-task: --yolo, agy is unsandboxed", file=sys.stderr)
    # Own process group so a SIGTERM/SIGINT to us (or a timeout) takes agy and its tools down too.
    p = subprocess.Popen(cmd, cwd=wt, text=True, stdin=subprocess.DEVNULL, start_new_session=True,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    interrupted = []

    def stop(signum=None, frame=None):
        interrupted.append(signum or "timeout")
        try:
            os.killpg(p.pid, signal.SIGTERM)
        except OSError:
            pass
    old = [signal.signal(sig, stop) for sig in (signal.SIGTERM, signal.SIGINT)]
    try:
        out, err = p.communicate(timeout=seconds(a.timeout) + 30)
    except subprocess.TimeoutExpired:
        stop()
        out, err = p.communicate()
    finally:
        for sig, h in zip((signal.SIGTERM, signal.SIGINT), old):
            signal.signal(sig, h)
    code = p.returncode
    (task / "pid").unlink(missing_ok=True)
    (task / "agy.log").write_text(f"{err}\n{out}")
    try:
        res = json.loads(out)
    except ValueError:
        res = {}
    warnings = list(warnings)
    if interrupted:
        warnings.append("interrupted: agy was stopped before it finished")
    if re.search(r"print timeout", err):  # agy exits 0 with partial output when its own timeout hits
        warnings.append("timed out: the response and edits may be incomplete")
    try:  # never lose agy's work to a hook or signing failure
        sh("git", "add", "-A", cwd=wt)
        if sh("git", "status", "--porcelain", cwd=wt):
            sh("git", "-c", "commit.gpgsign=false", "commit", "--no-verify", "-qm", f"agy: {task.name}", cwd=wt)
    except SystemExit as e:
        warnings.append(f"commit failed, changes are uncommitted in the worktree: {e}")
    base = (task / "base").read_text().strip()
    changed = sh("git", "diff", "--shortstat", base, "HEAD", cwd=wt, check=False) or "no changes"
    if changed == "no changes" and sh("git", "status", "--porcelain", cwd=wt, check=False):
        changed = "uncommitted changes"
    denied = [d.get("display_name", d.get("action")) for d in res.get("denied_actions", [])]
    review = a.review
    incomplete = any(w.startswith(("interrupted", "timed out")) for w in warnings)
    produced = bool(res.get("response", "").strip()) if review else changed != "no changes"
    ok = res.get("status") == "SUCCESS" and not denied and code == 0 and not incomplete and produced
    result = {"ok": ok, "slug": task.name, "branch": f"agy/{task.name}", "worktree": str(wt), "review": review,
              "base": base, "changes": changed, "denied_actions": denied, "warnings": warnings,
              "conversation_id": res.get("conversation_id"), "exit_code": code, "usage": res.get("usage"),
              "response": res.get("response", ""), "stderr": err.strip()[-500:]}
    (task / "result.json").write_text(json.dumps(result, indent=2))
    note = (f" DENIED: {', '.join(denied)}" if denied else "") + "".join(f" WARNING: {w}" for w in warnings)
    print(f"agy-task {task.name}: {'ok' if ok else 'NOT ok'} ({changed}){note} -> {task}/result.json")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawTextHelpFormatter)
    ap.add_argument("cmd", choices=["start", "resume", "list", "clean"])
    ap.add_argument("slug", nargs="?")
    ap.add_argument("prompt", nargs="?", help="task text, or - to read it from stdin")
    ap.add_argument("--model", default="gemini-3.8-flash-high")
    ap.add_argument("--effort")
    ap.add_argument("--timeout", default="20m")
    ap.add_argument("--base", default="HEAD")
    ap.add_argument("--setup", help="shell command run in the worktree before agy (start only)")
    ap.add_argument("--review", action="store_true")
    ap.add_argument("--yolo", action="store_true")
    ap.add_argument("--force", action="store_true")
    a = ap.parse_args()

    # The main checkout even when run from inside a task worktree (common dir is <repo>/.git).
    repo = Path(sh("git", "rev-parse", "--path-format=absolute", "--git-common-dir")).parent
    root = Path(os.environ.get("AGY_TASK_DIR", Path.home() / ".agy-tasks")) / repo.name
    if a.cmd == "list":
        for d in sorted(root.glob("*/")) if root.exists() else []:
            r = json.loads((d / "result.json").read_text()) if (d / "result.json").exists() else {}
            state = "running" if alive(d / "pid") else ("ok" if r.get("ok") else "NOT ok" if r else "unfinished")
            print(f"{d.name:24} {state:10} {r.get('changes', '')}")
        return 0
    if not a.slug or not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,40}", a.slug):
        sys.exit("agy-task: slug must be lowercase letters, digits, . _ - (max 41 chars)")
    task, branch = root / a.slug, f"agy/{a.slug}"

    if a.cmd == "clean":
        merged = subprocess.run(["git", "merge-base", "--is-ancestor", branch, "HEAD"], cwd=repo).returncode == 0
        if not (merged or a.force):
            sys.exit(f"agy-task: {branch} is not merged into HEAD; merge it or pass --force to discard")
        if (task / "worktree").exists():
            sh("git", "worktree", "remove", "--force", str(task / "worktree"), cwd=repo)
        sh("git", "branch", "-D", branch, cwd=repo, check=False)
        if task.exists():
            for f in task.iterdir():
                f.unlink()
            task.rmdir()
        return 0

    running = [f for f in root.glob("*/pid") if alive(f)]
    if len(running) >= int(os.environ.get("AGY_TASK_MAX", 3)):
        sys.exit(f"agy-task: {len(running)} tasks already running; wait for one (agy-task list)")
    prompt = sys.stdin.read() if a.prompt == "-" else a.prompt
    if not prompt:
        sys.exit("agy-task: a prompt (or -) is required")
    if a.cmd == "start":
        if task.exists():
            sys.exit(f"agy-task: {task} exists; pick another slug or run clean")
        task.mkdir(parents=True)
        (task / "base").write_text(sh("git", "rev-parse", a.base, cwd=repo))
        try:
            sh("git", "worktree", "add", "-q", "-b", branch, str(task / "worktree"), a.base, cwd=repo)
        except SystemExit:
            for f in task.iterdir():
                f.unlink()
            task.rmdir()
            raise
        dirty = sh("git", "status", "--porcelain", "--untracked-files=no", cwd=repo)
        warn = ["the main checkout has uncommitted changes; agy sees only the committed state "
                f"of {a.base}"] if dirty and a.base == "HEAD" else []
        for w in warn:
            print(f"agy-task: WARNING: {w}", file=sys.stderr)
        if a.setup:
            wt = task / "worktree"
            sh("sh", "-c", a.setup, cwd=wt)
            made = sh("git", "ls-files", "--others", "--exclude-standard", cwd=wt)
            if made:  # keep setup artifacts (e.g. a node_modules link) out of agy's commit
                with open(sh("git", "rev-parse", "--path-format=absolute", "--git-path", "info/exclude", cwd=wt), "a") as f:
                    f.write(made + "\n")
        return run_agy(task, prompt, a, warnings=warn)
    prev = json.loads((task / "result.json").read_text())
    if not prev.get("conversation_id"):
        sys.exit("agy-task: previous run has no conversation_id to resume")
    a.review = a.review or prev.get("review", False)  # a resumed review stays a review
    return run_agy(task, prompt, a, prev["conversation_id"])


if __name__ == "__main__":
    sys.exit(main())
