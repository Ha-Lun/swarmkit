diff --git a/svc/tests/test_migrations.py b/svc/tests/test_migrations.py
index 5ac2478..2492125 100644
--- a/svc/tests/test_migrations.py
+++ b/svc/tests/test_migrations.py
@@ -14,6 +14,17 @@ class MigrationTests(unittest.TestCase):
         self.assertEqual(db.execute("SELECT COUNT(*) FROM schema_migrations").fetchone()[0], len(
             [f for f in os.listdir(store.MIGRATIONS) if f.endswith(".sql")]))
 
+    def test_existing_database_gets_phone(self):
+        db = store.connect()
+        db.executescript(open(os.path.join(store.MIGRATIONS, "001_init.sql")).read())
+        db.execute("CREATE TABLE schema_migrations (name TEXT PRIMARY KEY)")
+        db.execute("INSERT INTO schema_migrations VALUES ('001_init.sql')")
+        db.execute("INSERT INTO users (name, email) VALUES ('Old', 'old@example.com')")
+        db.commit()
+        store.migrate(db)
+        user = store.get_user(db, 1)
+        self.assertEqual((user["name"], user["phone"]), ("Old", None))
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/svc/tests/test_users.py b/svc/tests/test_users.py
index 2fd5461..e1c3286 100644
--- a/svc/tests/test_users.py
+++ b/svc/tests/test_users.py
@@ -34,6 +34,34 @@ class UserTests(unittest.TestCase):
         status, body = app.handle("GET", "/users", {}, None, self.db)
         self.assertEqual([u["name"] for u in body["users"]], ["A", "B"])
 
+    def _create(self, **extra):
+        body = {"name": "P", "email": "p@example.com"}
+        body.update(extra)
+        return app.handle("POST", "/users", {}, body, self.db)
+
+    def test_phone_stored_and_returned(self):
+        status, user = self._create(phone="+46 70-123 45 67")
+        self.assertEqual((status, user["phone"]), (201, "+46 70-123 45 67"))
+        _, got = app.handle("GET", "/users/%d" % user["id"], {}, None, self.db)
+        self.assertEqual(got["phone"], "+46 70-123 45 67")
+        _, body = app.handle("GET", "/users", {}, None, self.db)
+        self.assertEqual(body["users"][0]["phone"], "+46 70-123 45 67")
+
+    def test_phone_optional(self):
+        status, user = self._create()
+        self.assertEqual((status, user["phone"]), (201, None))
+        self.assertEqual(self._create(phone=None)[0], 409)
+
+    def test_phone_invalid(self):
+        for bad in ["123456", "1" * 16, "abc1234567", "12+34567890", "++1234567", "", "123.456.7890", 1234567, "+"]:
+            status, body = self._create(phone=bad)
+            self.assertEqual(status, 400, bad)
+            self.assertEqual(body["errors"], ["phone is invalid"])
+
+    def test_phone_bounds(self):
+        self.assertEqual(self._create(email="a@example.com", phone="1234567")[0], 201)
+        self.assertEqual(self._create(email="b@example.com", phone="+" + "1" * 15)[0], 201)
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/svc/validate.py b/svc/validate.py
