diff --git a/svc/tests/test_users.py b/svc/tests/test_users.py
index 2fd5461..1dfdaa8 100644
--- a/svc/tests/test_users.py
+++ b/svc/tests/test_users.py
@@ -34,6 +34,26 @@ class UserTests(unittest.TestCase):
         status, body = app.handle("GET", "/users", {}, None, self.db)
         self.assertEqual([u["name"] for u in body["users"]], ["A", "B"])
 
+    def test_phone_stored_and_returned(self):
+        status, user = app.handle("POST", "/users", {}, {"name": "P", "email": "p@example.com", "phone": "+46 70-123 45 67"}, self.db)
+        self.assertEqual((status, user["phone"]), (201, "+46 70-123 45 67"))
+        _, got = app.handle("GET", "/users/%d" % user["id"], {}, None, self.db)
+        self.assertEqual(got["phone"], "+46 70-123 45 67")
+
+    def test_phone_optional(self):
+        _, user = app.handle("POST", "/users", {}, {"name": "P", "email": "p@example.com"}, self.db)
+        self.assertIsNone(user["phone"])
+
+    def test_phone_invalid(self):
+        for bad in ["123456", "1" * 16, "abc1234567", "12+34567890", "++1234567", "", 1234567, "1234567 x"]:
+            status, body = app.handle("POST", "/users", {}, {"name": "P", "email": "p@example.com", "phone": bad}, self.db)
+            self.assertEqual((status, body["errors"]), (400, ["phone is invalid"]), bad)
+
+    def test_phone_bounds_valid(self):
+        for i, ok in enumerate(["1234567", "+" + "1" * 15, "12-34 567"]):
+            status, _ = app.handle("POST", "/users", {}, {"name": "P", "email": "p%d@example.com" % i, "phone": ok}, self.db)
+            self.assertEqual(status, 201, ok)
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/svc/validate.py b/svc/validate.py
index 89ff6f5..a2b4d24 100644
--- a/svc/validate.py
+++ b/svc/validate.py
@@ -2,6 +2,7 @@
 import re
 
 EMAIL = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
+PHONE = re.compile(r"^\+?[0-9 -]+$")
 
 
 def validate_user(payload):
@@ -12,4 +13,9 @@ def validate_user(payload):
     email = payload.get("email")
     if not isinstance(email, str) or not EMAIL.match(email):
         errors.append("email is invalid")
+    phone = payload.get("phone")
+    if phone is not None and not (
+        isinstance(phone, str) and PHONE.match(phone) and 7 <= sum(c.isdigit() for c in phone) <= 15
+    ):
+        errors.append("phone is invalid")
     return errors
