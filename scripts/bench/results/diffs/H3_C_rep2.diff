diff --git a/svc/store.py b/svc/store.py
index 6c5bc2c..bd238c8 100644
--- a/svc/store.py
+++ b/svc/store.py
@@ -26,7 +26,15 @@ def migrate(db):
 
 
 def create_user(db, name, email):
-    cur = db.execute("INSERT INTO users (name, email) VALUES (?, ?)", (name, email))
+    # Emails are unique case-insensitively. Checked in the INSERT itself rather than by a
+    # UNIQUE index on lower(email), which could not be built on databases that already hold
+    # case-variant duplicates.
+    cur = db.execute(
+        "INSERT INTO users (name, email) SELECT ?, ? "
+        "WHERE NOT EXISTS (SELECT 1 FROM users WHERE lower(email) = lower(?))",
+        (name, email, email))
+    if cur.rowcount == 0:
+        raise sqlite3.IntegrityError("email already registered")
     db.commit()
     return get_user(db, cur.lastrowid)
 
