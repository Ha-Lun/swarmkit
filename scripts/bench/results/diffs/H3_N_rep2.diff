diff --git a/svc/migrations/002_email_ci_index.sql b/svc/migrations/002_email_ci_index.sql
new file mode 100644
index 0000000..09004e4
--- /dev/null
+++ b/svc/migrations/002_email_ci_index.sql
@@ -0,0 +1,5 @@
+-- Lookup index for case-insensitive email checks. Deliberately not UNIQUE:
+-- existing databases may already hold case-variant duplicates, and a unique
+-- index would make this migration fail on them. Uniqueness for new sign-ups
+-- is enforced in store.create_user.
+CREATE INDEX users_email_lower ON users (lower(email));
diff --git a/svc/store.py b/svc/store.py
index 6c5bc2c..1570d09 100644
--- a/svc/store.py
+++ b/svc/store.py
@@ -26,8 +26,15 @@ def migrate(db):
 
 
 def create_user(db, name, email):
-    cur = db.execute("INSERT INTO users (name, email) VALUES (?, ?)", (name, email))
+    # One atomic statement: reject the insert if any existing email matches ignoring case
+    # (this also covers rows created before case-insensitive checking existed).
+    cur = db.execute(
+        "INSERT INTO users (name, email) SELECT ?, ? "
+        "WHERE NOT EXISTS (SELECT 1 FROM users WHERE lower(email) = lower(?))",
+        (name, email, email))
     db.commit()
+    if cur.rowcount == 0:
+        raise sqlite3.IntegrityError("email already registered")
     return get_user(db, cur.lastrowid)
 
 
