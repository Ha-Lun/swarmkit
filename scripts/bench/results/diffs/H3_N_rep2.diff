+    def test_duplicate_against_legacy_mixed_case_row(self):
+        # Database as deployed before migration 002, containing a mixed-case account and a legacy duplicate.
+        db = store.connect()
+        db.executescript(open(os.path.join(store.MIGRATIONS, "001_init.sql")).read())
+        db.execute("CREATE TABLE schema_migrations (name TEXT PRIMARY KEY)")
+        db.execute("INSERT INTO schema_migrations VALUES ('001_init.sql')")
+        db.execute("INSERT INTO users (name, email) VALUES ('Ada', 'Ada@Example.com')")
+        db.execute("INSERT INTO users (name, email) VALUES ('Ada dup', 'ADA@example.com')")
+        db.commit()
+        store.migrate(db)  # must not fail on existing duplicates
+        status, _ = app.handle("POST", "/users", {}, {"name": "x", "email": "ada@EXAMPLE.com"}, db)
+        self.assertEqual(status, 409)
+        status, _ = app.handle("POST", "/users", {}, {"name": "Bob", "email": "bob@example.com"}, db)
+        self.assertEqual(status, 201)
+
