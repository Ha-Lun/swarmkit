         self.assertEqual(db.execute("SELECT COUNT(*) FROM schema_migrations").fetchone()[0], len(
             [f for f in os.listdir(store.MIGRATIONS) if f.endswith(".sql")]))
 
+    def test_upgrade_keeps_existing_users(self):
+        db = store.connect()
+        db.execute("CREATE TABLE schema_migrations (name TEXT PRIMARY KEY)")
+        db.executescript(open(os.path.join(store.MIGRATIONS, "001_init.sql")).read())
+        db.execute("INSERT INTO schema_migrations (name) VALUES ('001_init.sql')")
+        db.execute("INSERT INTO users (id, name, email) VALUES (3, 'A', 'a@example.com'), (7, 'B', 'b@example.com')")
+        db.execute("DELETE FROM users WHERE id = 7")
+        db.execute("INSERT INTO users (name, email) VALUES ('C', 'c@example.com')")  # id 8
+        db.commit()
+        store.migrate(db)
+        self.assertEqual([(u["id"], u["email"]) for u in store.list_users(db)],
+                         [(3, "a@example.com"), (8, "c@example.com")])
+        self.assertEqual(store.create_user(db, "D", "d@example.com")["id"], 9)
+
 
 if __name__ == "__main__":
     unittest.main()
