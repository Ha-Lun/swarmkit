+class ImportTests(unittest.TestCase):
+    def setUp(self):
+        self.db = store.connect()
+        store.migrate(self.db)
+
+    def post(self, body):
+        return app.handle("POST", "/users/import", {}, body, self.db)
+
+    def count(self):
+        return len(app.handle("GET", "/users", {}, None, self.db)[1]["users"])
+
+    def test_success_in_order(self):
+        status, body = self.post({"users": [{"name": " B ", "email": "b@example.com"}, {"name": "A", "email": "a@example.com"}]})
+        self.assertEqual(status, 201)
+        self.assertEqual([u["name"] for u in body["users"]], ["B", "A"])
+        self.assertEqual(self.count(), 2)
+
+    def test_bad_shape(self):
+        for body in (None, [], {}, {"users": []}, {"users": "x"}, {"users": {"a": 1}}):
+            self.assertEqual(self.post(body)[0], 400, body)
+
+    def test_entry_not_object(self):
+        status, body = self.post({"users": [{"name": "A", "email": "a@example.com"}, "x"]})
+        self.assertEqual(status, 400)
+        self.assertEqual(body["errors"][0]["index"], 1)
+        self.assertEqual(self.count(), 0)
+
+    def test_validation_errors_create_nothing(self):
+        status, body = self.post({"users": [{"name": "A", "email": "a@example.com"}, {"name": "", "email": "nope"}]})
+        self.assertEqual(status, 400)
+        self.assertEqual(body, {"errors": [{"index": 1, "errors": ["name is required", "email is invalid"]}]})
+        self.assertEqual(self.count(), 0)
+
+    def test_duplicate_in_batch_ignores_case(self):
+        status, body = self.post({"users": [
+            {"name": "A", "email": "a@example.com"},
+            {"name": "B", "email": "b@example.com"},
+            {"name": "C", "email": "A@Example.com"},
+        ]})
+        self.assertEqual((status, body), (409, {"errors": [{"index": 2, "error": "email already registered"}]}))
+        self.assertEqual(self.count(), 0)
+
+    def test_existing_email_ignores_case(self):
+        app.handle("POST", "/users", {}, {"name": "Ada", "email": "Ada@example.com"}, self.db)
+        status, body = self.post({"users": [{"name": "X", "email": "x@example.com"}, {"name": "A", "email": "ada@EXAMPLE.com"}]})
+        self.assertEqual((status, body), (409, {"errors": [{"index": 1, "error": "email already registered"}]}))
+        self.assertEqual(self.count(), 1)
+
+    def test_limit(self):
+        def users(n):
+            return [{"name": "U", "email": "u%d@example.com" % i} for i in range(n)]
+        self.assertEqual(self.post({"users": users(101)})[0], 413)
+        self.assertEqual(self.count(), 0)
+        self.assertEqual(self.post({"users": users(100)})[0], 201)
+        self.assertEqual(self.count(), 100)
+
+
 if __name__ == "__main__":
     unittest.main()
