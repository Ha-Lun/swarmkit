@@ -5,6 +5,34 @@ import store
 import validate
 
 
+MAX_IMPORT = 100
+
+
+def import_users(body, db):
+    entries = body.get("users") if isinstance(body, dict) else None
+    if not isinstance(entries, list) or not entries:
+        return 400, {"errors": [{"error": "users must be a non-empty list"}]}
+    if len(entries) > MAX_IMPORT:
+        return 413, {"error": "at most %d users per request" % MAX_IMPORT}
+    errors = [
+        {"index": i, "errors": validate.validate_user(e) if isinstance(e, dict) else ["entry must be an object"]}
+        for i, e in enumerate(entries)
+    ]
+    errors = [e for e in errors if e["errors"]]
+    if errors:
+        return 400, {"errors": errors}
+    seen = store.emails_lowercase(db)
+    conflicts = []
+    for i, e in enumerate(entries):
+        key = e["email"].lower()
+        if key in seen:
+            conflicts.append({"index": i, "error": "email already registered"})
+        seen.add(key)
+    if conflicts:
+        return 409, {"errors": conflicts}
+    return 201, {"users": store.create_users(db, [(e["name"].strip(), e["email"]) for e in entries])}
+
+
