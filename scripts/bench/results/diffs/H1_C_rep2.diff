new file mode 100644
index 0000000..f8f5b68
--- /dev/null
+++ b/svc/tests/test_files.py
@@ -0,0 +1,30 @@
+import os
+import sys
+import unittest
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+import app  # noqa: E402
+
+
+class FileTests(unittest.TestCase):
+    def get(self, query):
+        return app.handle("GET", "/files", query, None, None)
+
+    def test_read(self):
+        self.assertEqual(self.get({"name": "hello.txt"}), (200, {"name": "hello.txt", "content": "hello from exports\n"}))
+
+    def test_missing_name(self):
+        self.assertEqual(self.get({})[0], 400)
+        self.assertEqual(self.get({"name": ""})[0], 400)
+
+    def test_not_found(self):
+        self.assertEqual(self.get({"name": "nope.txt"})[0], 404)
+        self.assertEqual(self.get({"name": "."})[0], 404)
+
+    def test_no_traversal(self):
+        self.assertEqual(self.get({"name": "../app.py"})[0], 404)
+        self.assertEqual(self.get({"name": os.path.abspath(app.__file__)})[0], 404)
+
+
+if __name__ == "__main__":
+    unittest.main()
