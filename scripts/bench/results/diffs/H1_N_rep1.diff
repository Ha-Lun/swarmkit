+    def test_file(self):
+        with open(os.path.join(app.EXPORTS_DIR, "hello.txt"), encoding="utf-8") as f:
+            expected = f.read()
+        status, body = app.handle("GET", "/files", {"name": "hello.txt"}, None, self.db)
+        self.assertEqual(status, 200)
+        self.assertEqual(body, {"name": "hello.txt", "content": expected})
+
+    def test_file_missing_name(self):
+        status, _ = app.handle("GET", "/files", {}, None, self.db)
+        self.assertEqual(status, 400)
+        status, _ = app.handle("GET", "/files", {"name": ""}, None, self.db)
+        self.assertEqual(status, 400)
+
+    def test_file_not_found(self):
+        status, _ = app.handle("GET", "/files", {"name": "nope.txt"}, None, self.db)
+        self.assertEqual(status, 404)
+
+    def test_file_outside_exports(self):
+        for name in ("../app.py", "../../README.md", app.__file__):
