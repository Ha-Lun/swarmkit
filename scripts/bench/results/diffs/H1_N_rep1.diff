 """Request handling for the user service: handle(...) -> (status, body). No sockets, so it is testable directly."""
+import os
 import sqlite3
 
 import store
 import validate
 
+EXPORTS_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "exports")
+
+
+def read_export(name):
+    """Contents of a file directly inside EXPORTS_DIR, or None. Names that resolve outside it (../, absolute, symlinks) count as missing."""
+    root = os.path.realpath(EXPORTS_DIR)
+    path = os.path.realpath(os.path.join(root, name))
+    if os.path.dirname(path) != root or not os.path.isfile(path):
+        return None
+    with open(path, encoding="utf-8") as f:
+        return f.read()
+
 
 def handle(method, path, query, body, db):
     if method == "GET" and path == "/health":
         return 200, {"status": "ok"}
+    if method == "GET" and path == "/files":
+        name = (query or {}).get("name")
+        if not name:
+            return 400, {"error": "name is required"}
+        content = read_export(name)
+        if content is None:
+            return 404, {"error": "not found"}
+        return 200, {"name": name, "content": content}
     if method == "GET" and path == "/users":
         return 200, {"users": store.list_users(db)}
     if method == "GET" and path.startswith("/users/"):
