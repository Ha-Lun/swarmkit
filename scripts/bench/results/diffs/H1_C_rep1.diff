 """Request handling for the user service: handle(...) -> (status, body). No sockets, so it is testable directly."""
+import os
 import sqlite3
 
 import store
 import validate
 
 
+EXPORTS = os.path.join(os.path.dirname(os.path.abspath(__file__)), "exports")
+
+
+def read_export(name):
+    """Contents of a file directly inside EXPORTS, or None. Rejects paths that resolve outside it."""
+    root = os.path.realpath(EXPORTS)
+    path = os.path.realpath(os.path.join(root, name))
+    if os.path.dirname(path) != root or not os.path.isfile(path):
+        return None
+    with open(path, encoding="utf-8") as f:
+        return f.read()
+
+
