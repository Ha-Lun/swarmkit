diff --git a/svc/docs/API.md b/svc/docs/API.md
index d96c758..a4b47c0 100644
--- a/svc/docs/API.md
+++ b/svc/docs/API.md
@@ -6,5 +6,8 @@
 | GET | /users | All users, by id. |
 | GET | /users/<id> | One user, or 404. |
 | POST | /users | Create a user from `{name, email}`. 201, 400 on invalid input, 409 if the email is taken. |
+| DELETE | /users/<id> | Soft delete: the row is kept with a `deleted_at` timestamp. 200 `{"deleted": <id>}`, or 404 if the user is unknown or already deleted. |
+
+Deleted users are not returned by GET /users and GET /users/<id> is 404 for them. Their email can be registered again; emails are unique among active users only.
 
 A user is `{id, name, email}`.
diff --git a/svc/migrations/002_soft_delete.sql b/svc/migrations/002_soft_delete.sql
new file mode 100644
index 0000000..80f3fef
--- /dev/null
+++ b/svc/migrations/002_soft_delete.sql
@@ -0,0 +1,17 @@
+-- Soft delete: add deleted_at and make email unique among active users only.
+-- SQLite cannot drop the column-level UNIQUE, so rebuild the table, keeping ids.
+BEGIN;
+CREATE TABLE users_new (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  name TEXT NOT NULL,
+  email TEXT NOT NULL,
+  deleted_at TEXT
+);
+INSERT INTO users_new (id, name, email) SELECT id, name, email FROM users;
+-- keep the id counter so ids of previously removed rows are never reused
+DELETE FROM sqlite_sequence WHERE name = 'users_new';
+INSERT INTO sqlite_sequence (name, seq) SELECT 'users_new', seq FROM sqlite_sequence WHERE name = 'users';
+DROP TABLE users;
+ALTER TABLE users_new RENAME TO users;
+CREATE UNIQUE INDEX users_email_active ON users (email) WHERE deleted_at IS NULL;
+COMMIT;
