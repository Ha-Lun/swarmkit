+    def test_upgrade_keeps_existing_users(self):
+        db = store.connect()
+        db.execute("CREATE TABLE schema_migrations (name TEXT PRIMARY KEY)")
+        db.executescript(open(os.path.join(store.MIGRATIONS, "001_init.sql")).read())
+        db.execute("INSERT INTO schema_migrations (name) VALUES ('001_init.sql')")
+        db.execute("INSERT INTO users (id, name, email) VALUES (3, 'Old', 'old@example.com')")
+        db.execute("INSERT INTO users (id, name, email) VALUES (7, 'Older', 'older@example.com')")
+        db.execute("DELETE FROM users WHERE id = 7")
+        db.commit()
+        store.migrate(db)
+        self.assertEqual([dict(r) for r in db.execute("SELECT id, name, email, deleted_at FROM users")],
+                         [{"id": 3, "name": "Old", "email": "old@example.com", "deleted_at": None}])
+        new = db.execute("INSERT INTO users (name, email) VALUES ('N', 'n@example.com')").lastrowid
+        self.assertEqual(new, 8)
+
+
 if __name__ == "__main__":
