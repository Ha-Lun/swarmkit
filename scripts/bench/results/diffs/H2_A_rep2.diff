         self.assertEqual(db.execute("SELECT COUNT(*) FROM schema_migrations").fetchone()[0], len(
             [f for f in os.listdir(store.MIGRATIONS) if f.endswith(".sql")]))
 
+    def test_existing_database_upgrades(self):
+        db = store.connect()
+        db.execute("CREATE TABLE schema_migrations (name TEXT PRIMARY KEY)")
+        db.executescript(open(os.path.join(store.MIGRATIONS, "001_init.sql")).read())
+        db.execute("INSERT INTO schema_migrations VALUES ('001_init.sql')")
+        db.execute("INSERT INTO users (name, email) VALUES ('Old', 'old@example.com')")
+        store.migrate(db)
+        self.assertIsNone(store.get_user(db, 1)["phone"])
+        self.assertEqual(store.get_user(db, 1)["name"], "Old")
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/svc/tests/test_users.py b/svc/tests/test_users.py
index 2fd5461..414229a 100644
--- a/svc/tests/test_users.py
+++ b/svc/tests/test_users.py
@@ -28,6 +28,32 @@ class UserTests(unittest.TestCase):
         status, _ = app.handle("POST", "/users", {}, {"name": "Ada 2", "email": "ada@example.com"}, self.db)
         self.assertEqual(status, 409)
 
+    def post(self, **extra):
+        body = {"name": "P", "email": "p@example.com", **extra}
+        return app.handle("POST", "/users", {}, body, self.db)
+
+    def test_phone_stored_and_returned(self):
+        status, user = self.post(phone="+46 70-123 45 67")
+        self.assertEqual((status, user["phone"]), (201, "+46 70-123 45 67"))
+        _, got = app.handle("GET", "/users/%d" % user["id"], {}, None, self.db)
+        self.assertEqual(got["phone"], "+46 70-123 45 67")
+        _, body = app.handle("GET", "/users", {}, None, self.db)
+        self.assertEqual(body["users"][0]["phone"], "+46 70-123 45 67")
+
+    def test_phone_optional(self):
+        status, user = self.post()
+        self.assertEqual((status, user["phone"]), (201, None))
+
+    def test_phone_invalid(self):
+        for bad in ["123456", "1" * 16, "abc1234567", "12+34567890", "++1234567", "", 1234567, "12345 (67)"]:
+            self.db.execute("DELETE FROM users")
+            status, body = self.post(phone=bad)
+            self.assertEqual((status, body), (400, {"errors": ["phone is invalid"]}), bad)
+
+    def test_phone_bounds(self):
+        self.assertEqual(self.post(phone="1234567")[0], 201)
+        self.assertEqual(self.post(phone="+" + "1" * 15, email="q@example.com")[0], 201)
+
     def test_list(self):
         app.handle("POST", "/users", {}, {"name": "A", "email": "a@example.com"}, self.db)
         app.handle("POST", "/users", {}, {"name": "B", "email": "b@example.com"}, self.db)
diff --git a/svc/validate.py b/svc/validate.py
index 89ff6f5..5b26112 100644
--- a/svc/validate.py
+++ b/svc/validate.py
@@ -2,6 +2,7 @@
 import re
 
 EMAIL = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
+PHONE = re.compile(r"^\+?[0-9 -]+$")
 
 
 def validate_user(payload):
@@ -12,4 +13,8 @@ def validate_user(payload):
     email = payload.get("email")
     if not isinstance(email, str) or not EMAIL.match(email):
         errors.append("email is invalid")
+    phone = payload.get("phone")
+    if phone is not None:
+        if not isinstance(phone, str) or not PHONE.match(phone) or not 7 <= sum(c.isdigit() for c in phone) <= 15:
+            errors.append("phone is invalid")
     return errors
