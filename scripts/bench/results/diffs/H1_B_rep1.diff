 """Request handling for the user service: handle(...) -> (status, body). No sockets, so it is testable directly."""
+import os
 import sqlite3
 
 import store
 import validate
 
+EXPORTS_DIR = os.path.realpath(os.path.join(os.path.dirname(__file__), "exports"))
+
+
+def read_export(name):
+    """Contents of a file inside EXPORTS_DIR, or None if it is missing or resolves outside it."""
+    path = os.path.realpath(os.path.join(EXPORTS_DIR, name))
+    if os.path.commonpath([EXPORTS_DIR, path]) != EXPORTS_DIR or not os.path.isfile(path):
+        return None
+    with open(path, encoding="utf-8") as f:
+        return f.read()
+
 
