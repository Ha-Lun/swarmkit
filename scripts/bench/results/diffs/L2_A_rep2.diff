     return 404, {"error": "not found"}
+
+
+MAX_IMPORT = 100
+
+
+def import_users(body, db):
+    """All-or-nothing bulk create. Checks run in order: size/shape (413/400), per-entry validation (400), duplicates (409)."""
+    entries = body.get("users") if isinstance(body, dict) else None
+    if not isinstance(entries, list) or not entries:
+        return 400, {"error": "users must be a non-empty list"}
+    if len(entries) > MAX_IMPORT:
+        return 413, {"error": "at most %d users per request" % MAX_IMPORT}
+    errors = []
+    for i, entry in enumerate(entries):
+        errs = validate.validate_user(entry) if isinstance(entry, dict) else ["entry must be an object"]
+        if errs:
+            errors.append({"index": i, "errors": errs})
+    if errors:
+        return 400, {"errors": errors}
+    taken = store.emails_taken(db, [e["email"] for e in entries])
+    seen = set()
+    dupes = []
+    for i, entry in enumerate(entries):
+        key = entry["email"].lower()
+        if key in taken or key in seen:
+            dupes.append({"index": i, "error": "email already registered"})
+        seen.add(key)
+    if dupes:
+        return 409, {"errors": dupes}
+    try:
+        return 201, {"users": store.create_users(db, [(e["name"].strip(), e["email"]) for e in entries])}
+    except sqlite3.IntegrityError:
+        return 409, {"error": "email already registered"}
diff --git a/svc/docs/API.md b/svc/docs/API.md
index d96c758..1cfffae 100644
--- a/svc/docs/API.md
+++ b/svc/docs/API.md
@@ -6,5 +6,20 @@
 | GET | /users | All users, by id. |
 | GET | /users/<id> | One user, or 404. |
 | POST | /users | Create a user from `{name, email}`. 201, 400 on invalid input, 409 if the email is taken. |
+| POST | /users/import | Create many users atomically from `{"users": [{name, email}, ...]}` (see below). |
+
+### POST /users/import
+
+All-or-nothing: if any entry is rejected, nothing is created. Each entry is validated like `POST /users`. Emails are compared ignoring capitalisation: an email may not already exist, nor appear twice in the batch.
+
+| Status | When | Body |
+|---|---|---|
+| 201 | All created | `{"users": [...]}` in input order |
+| 400 | `users` missing, empty or not a list | `{"error": "..."}` |
+| 400 | An entry is not an object, or fails validation | `{"errors": [{"index": i, "errors": [...]}]}` |
+| 409 | Duplicate email (existing, or repeated in the batch; index is the later entry) | `{"errors": [{"index": i, "error": "email already registered"}]}` |
+| 413 | More than 100 users | `{"error": "..."}` |
+
+Validation errors (400) take precedence over duplicates (409).
 
 A user is `{id, name, email}`.
