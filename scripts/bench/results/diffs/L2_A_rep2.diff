@@ -38,3 +38,20 @@ def get_user(db, user_id):
 
 def list_users(db):
     return [dict(r) for r in db.execute("SELECT * FROM users ORDER BY id")]
+
+
+def emails_taken(db, emails):
+    """The subset of `emails` already registered, compared ignoring case; returned lowercased."""
+    wanted = {e.lower() for e in emails}
+    return {r["email"].lower() for r in db.execute("SELECT email FROM users")} & wanted
+
+
+def create_users(db, entries):
+    """Insert all (name, email) pairs in one transaction: either every user is created or none. Returns them in order."""
+    try:
+        ids = [db.execute("INSERT INTO users (name, email) VALUES (?, ?)", e).lastrowid for e in entries]
+        db.commit()
+    except Exception:
+        db.rollback()
+        raise
+    return [get_user(db, i) for i in ids]
