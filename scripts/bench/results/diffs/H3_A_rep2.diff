diff --git a/svc/store.py b/svc/store.py
index 6c5bc2c..c599ed9 100644
--- a/svc/store.py
+++ b/svc/store.py
@@ -26,7 +26,21 @@ def migrate(db):
 
 
 def create_user(db, name, email):
-    cur = db.execute("INSERT INTO users (name, email) VALUES (?, ?)", (name, email))
+    """Insert a user; raises sqlite3.IntegrityError if the email is taken, ignoring case.
+
+    The UNIQUE constraint on users.email is case-sensitive, and existing databases may already
+    hold case-variant duplicates (so a unique index on lower(email) could not be built there).
+    The check is therefore done here, under a write lock so concurrent sign-ups cannot race.
+    """
+    db.commit()
+    db.execute("BEGIN IMMEDIATE")
+    try:
+        if db.execute("SELECT 1 FROM users WHERE lower(email) = lower(?)", (email,)).fetchone():
+            raise sqlite3.IntegrityError("email already registered")
+        cur = db.execute("INSERT INTO users (name, email) VALUES (?, ?)", (name, email))
+    except BaseException:
+        db.rollback()
+        raise
     db.commit()
     return get_user(db, cur.lastrowid)
 
