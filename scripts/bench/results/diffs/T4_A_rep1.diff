+def files_under(base, subdirs=('',)):
+    found = set()
+    for sub in subdirs:
+        for dirpath, _, names in os.walk(os.path.join(base, sub)):
+            found.update(os.path.relpath(os.path.join(dirpath, n), base) for n in names)
+    return found
+
+
+def stale_outputs():
+    """Build into a temp dir and return the repo paths that differ from it."""
+    global OUT
+    with tempfile.TemporaryDirectory() as tmp:
+        OUT = tmp
+        try:
+            build_all()
+        finally:
+            OUT = ROOT
+        fresh = files_under(tmp)
+        existing = files_under(ROOT, GENERATED_DIRS)
+        stale = set(existing - fresh)
+        for rel in fresh:
+            path = os.path.join(ROOT, rel)
+            if not os.path.isfile(path) or open(path, 'rb').read() != open(os.path.join(tmp, rel), 'rb').read():
+                stale.add(rel)
+    return sorted(stale)
+
+
