 import validate
 
 
+MAX_IMPORT = 100
+
+
+def import_users(body, db):
+    users = body.get("users") if isinstance(body, dict) else None
+    if not isinstance(users, list) or not users:
+        return 400, {"errors": ["users must be a non-empty list"]}
+    if len(users) > MAX_IMPORT:
+        return 413, {"error": "at most %d users per request" % MAX_IMPORT}
+    invalid = []
+    for i, entry in enumerate(users):
+        errors = validate.validate_user(entry) if isinstance(entry, dict) else ["entry must be an object"]
+        if errors:
+            invalid.append({"index": i, "errors": errors})
+    if invalid:
+        return 400, {"errors": invalid}
+    seen = store.emails_lower(db)
+    duplicates = []
+    for i, entry in enumerate(users):
+        key = entry["email"].lower()
+        if key in seen:
+            duplicates.append({"index": i, "error": "email already registered"})
+        seen.add(key)
+    if duplicates:
+        return 409, {"errors": duplicates}
+    try:
+        created = store.create_users(db, [(u["name"].strip(), u["email"]) for u in users])
+    except sqlite3.IntegrityError:
+        return 409, {"error": "email already registered"}
+    return 201, {"users": created}
+
