+++ b/svc/store.py
@@ -31,6 +31,21 @@ def create_user(db, name, email):
     return get_user(db, cur.lastrowid)
 
 
+def create_users(db, users):
+    """Insert all (name, email) pairs in one transaction: all of them or none. Returns them in input order."""
+    try:
+        ids = [db.execute("INSERT INTO users (name, email) VALUES (?, ?)", u).lastrowid for u in users]
+    except sqlite3.IntegrityError:
+        db.rollback()
+        raise
+    db.commit()
+    return [get_user(db, i) for i in ids]
+
+
+def emails_lower(db):
+    return {r["email"].lower() for r in db.execute("SELECT email FROM users")}
+
+
 def get_user(db, user_id):
     row = db.execute("SELECT * FROM users WHERE id = ?", (user_id,)).fetchone()
     return dict(row) if row else None
