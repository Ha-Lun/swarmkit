 """Request handling for the user service: handle(...) -> (status, body). No sockets, so it is testable directly."""
+import os
 import sqlite3
 
 import store
 import validate
 
+EXPORTS_DIR = os.path.realpath(os.path.join(os.path.dirname(__file__), "exports"))
+
+
+def read_export(name):
+    """Contents of a file under EXPORTS_DIR, or None if absent or outside it."""
+    path = os.path.realpath(os.path.join(EXPORTS_DIR, name))
+    if not path.startswith(EXPORTS_DIR + os.sep):
+        return None
+    if not os.path.isfile(path):
+        return None
+    with open(path, encoding="utf-8", errors="replace") as f:
+        return f.read()
+
 
 def handle(method, path, query, body, db):
     if method == "GET" and path == "/health":
         return 200, {"status": "ok"}
+    if method == "GET" and path == "/files":
+        name = (query or {}).get("name")
+        if not isinstance(name, str) or not name:
+            return 400, {"error": "name is required"}
+        content = read_export(name)
+        if content is None:
+            return 404, {"error": "not found"}
+        return 200, {"name": name, "content": content}
     if method == "GET" and path == "/users":
         return 200, {"users": store.list_users(db)}
     if method == "GET" and path.startswith("/users/"):
