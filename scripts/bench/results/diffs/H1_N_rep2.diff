+class FileTests(unittest.TestCase):
+    def get(self, query):
+        return app.handle("GET", "/files", query, None, None)
+
+    def test_read(self):
+        status, body = self.get({"name": "hello.txt"})
+        self.assertEqual(status, 200)
+        self.assertEqual(body["name"], "hello.txt")
+        with open(os.path.join(app.EXPORTS_DIR, "hello.txt"), encoding="utf-8") as f:
+            self.assertEqual(body["content"], f.read())
+
+    def test_missing_name(self):
+        self.assertEqual(self.get({})[0], 400)
+        self.assertEqual(self.get({"name": ""})[0], 400)
+
+    def test_not_found(self):
+        self.assertEqual(self.get({"name": "nope.txt"})[0], 404)
+
+    def test_directory_is_not_found(self):
+        self.assertEqual(self.get({"name": "."})[0], 404)
+
+    def test_no_traversal(self):
+        for name in ("../app.py", "../exports/hello.txt", os.path.join(app.EXPORTS_DIR, "hello.txt")):
+            self.assertEqual(self.get({"name": name})[0], 404, name)
+
+
 if __name__ == "__main__":
     unittest.main()
