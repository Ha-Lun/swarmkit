 """Request handling for the user service: handle(...) -> (status, body). No sockets, so it is testable directly."""
+import os
 import sqlite3
 
 import store
 import validate
 
+EXPORTS_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "exports")
+
+
+def read_export(name):
+    """Contents of a file directly inside EXPORTS_DIR, or None if it is not there (or escapes the directory)."""
+    if os.path.basename(name) != name:
+        return None
+    root = os.path.realpath(EXPORTS_DIR)
+    path = os.path.realpath(os.path.join(root, name))
+    if os.path.dirname(path) != root or not os.path.isfile(path):
+        return None
+    try:
+        with open(path, encoding="utf-8") as f:
+            return f.read()
+    except (OSError, UnicodeDecodeError):
+        return None
+
 
