         status, body = app.handle("GET", "/users", {}, None, self.db)
         self.assertEqual([u["name"] for u in body["users"]], ["A", "B"])
 
+    def _make(self, name, email):
+        return app.handle("POST", "/users", {}, {"name": name, "email": email}, self.db)
+
+    def test_delete(self):
+        _, a = self._make("A", "a@example.com")
+        self._make("B", "b@example.com")
+        self.assertEqual(app.handle("DELETE", "/users/%d" % a["id"], {}, None, self.db), (200, {"deleted": a["id"]}))
+        self.assertEqual(app.handle("GET", "/users/%d" % a["id"], {}, None, self.db)[0], 404)
+        _, body = app.handle("GET", "/users", {}, None, self.db)
+        self.assertEqual([u["name"] for u in body["users"]], ["B"])
+        row = self.db.execute("SELECT deleted_at FROM users WHERE id = ?", (a["id"],)).fetchone()
+        self.assertIsNotNone(row["deleted_at"])
+
+    def test_delete_unknown_or_twice(self):
+        _, a = self._make("A", "a@example.com")
+        self.assertEqual(app.handle("DELETE", "/users/999", {}, None, self.db)[0], 404)
+        self.assertEqual(app.handle("DELETE", "/users/x", {}, None, self.db)[0], 404)
+        app.handle("DELETE", "/users/%d" % a["id"], {}, None, self.db)
+        self.assertEqual(app.handle("DELETE", "/users/%d" % a["id"], {}, None, self.db)[0], 404)
+
+    def test_email_reusable_after_delete(self):
+        _, a = self._make("A", "a@example.com")
+        app.handle("DELETE", "/users/%d" % a["id"], {}, None, self.db)
+        status, b = self._make("A2", "a@example.com")
+        self.assertEqual(status, 201)
+        self.assertNotEqual(b["id"], a["id"])
+        self.assertEqual(self._make("A3", "a@example.com")[0], 409)
+
 
 if __name__ == "__main__":
     unittest.main()
