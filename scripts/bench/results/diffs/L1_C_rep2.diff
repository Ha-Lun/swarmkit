+    def test_upgrade_keeps_existing_users(self):
+        db = store.connect()
+        db.executescript(open(os.path.join(store.MIGRATIONS, "001_init.sql")).read())
+        db.execute("CREATE TABLE schema_migrations (name TEXT PRIMARY KEY)")
+        db.execute("INSERT INTO schema_migrations VALUES ('001_init.sql')")
+        db.execute("INSERT INTO users (id, name, email) VALUES (3, 'A', 'a@example.com'), (7, 'B', 'b@example.com')")
+        db.execute("DELETE FROM users WHERE id = 7")
+        db.commit()
+        store.migrate(db)
+        self.assertEqual(store.list_users(db), [{"id": 3, "name": "A", "email": "a@example.com"}])
+        self.assertEqual(store.create_user(db, "C", "c@example.com")["id"], 8)
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/svc/tests/test_users.py b/svc/tests/test_users.py
