diff --git a/svc/store.py b/svc/store.py
index 6c5bc2c..eb4a934 100644
--- a/svc/store.py
+++ b/svc/store.py
@@ -26,6 +26,11 @@ def migrate(db):
 
 
 def create_user(db, name, email):
+    # Emails are unique case-insensitively. Checked here rather than with a unique index on
+    # lower(email) so it also holds for existing databases, where such an index could not be
+    # created if case-variant duplicates are already present.
+    if db.execute("SELECT 1 FROM users WHERE lower(email) = lower(?)", (email,)).fetchone():
+        raise sqlite3.IntegrityError("email already registered")
     cur = db.execute("INSERT INTO users (name, email) VALUES (?, ?)", (name, email))
     db.commit()
     return get_user(db, cur.lastrowid)
