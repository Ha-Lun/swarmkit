+    def test_upgrade_keeps_existing_users(self):
+        db = store.connect()
+        db.executescript(open(os.path.join(store.MIGRATIONS, "001_init.sql")).read())
+        db.execute("CREATE TABLE schema_migrations (name TEXT PRIMARY KEY)")
+        db.execute("INSERT INTO schema_migrations VALUES ('001_init.sql')")
+        db.execute("INSERT INTO users (name, email) VALUES ('A', 'a@x.io'), ('B', 'b@x.io'), ('C', 'c@x.io')")
+        db.execute("DELETE FROM users WHERE id = 3")  # counter must stay at 3
+        db.commit()
+        store.migrate(db)
+        self.assertEqual([(u["id"], u["email"]) for u in store.list_users(db)], [(1, "a@x.io"), (2, "b@x.io")])
+        self.assertEqual(store.create_user(db, "D", "d@x.io")["id"], 4)
+
 
