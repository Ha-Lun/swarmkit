+    def _make(self, name, email):
+        return app.handle("POST", "/users", {}, {"name": name, "email": email}, self.db)
+
+    def test_delete(self):
+        _, u = self._make("A", "a@example.com")
+        self.assertEqual(app.handle("DELETE", "/users/%d" % u["id"], {}, None, self.db), (200, {"deleted": u["id"]}))
+        self.assertEqual(app.handle("GET", "/users/%d" % u["id"], {}, None, self.db)[0], 404)
+        self.assertEqual(app.handle("GET", "/users", {}, None, self.db)[1], {"users": []})
+        row = self.db.execute("SELECT deleted_at FROM users WHERE id = ?", (u["id"],)).fetchone()
+        self.assertIsNotNone(row["deleted_at"])
+
+    def test_delete_unknown_or_twice(self):
+        self.assertEqual(app.handle("DELETE", "/users/99", {}, None, self.db)[0], 404)
+        self.assertEqual(app.handle("DELETE", "/users/abc", {}, None, self.db)[0], 404)
+        _, u = self._make("A", "a@example.com")
+        app.handle("DELETE", "/users/%d" % u["id"], {}, None, self.db)
+        self.assertEqual(app.handle("DELETE", "/users/%d" % u["id"], {}, None, self.db)[0], 404)
+
+    def test_email_reusable_after_delete(self):
+        _, u = self._make("A", "a@example.com")
+        app.handle("DELETE", "/users/%d" % u["id"], {}, None, self.db)
+        status, u2 = self._make("A2", "a@example.com")
