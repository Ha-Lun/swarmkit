diff --git a/svc/tests/test_users.py b/svc/tests/test_users.py
index 2fd5461..6ad3264 100644
--- a/svc/tests/test_users.py
+++ b/svc/tests/test_users.py
@@ -34,6 +34,28 @@ class UserTests(unittest.TestCase):
         status, body = app.handle("GET", "/users", {}, None, self.db)
         self.assertEqual([u["name"] for u in body["users"]], ["A", "B"])
 
+    def test_phone_stored_and_returned(self):
+        status, user = app.handle("POST", "/users", {}, {"name": "A", "email": "a@example.com", "phone": "+46 70-123 45 67"}, self.db)
+        self.assertEqual((status, user["phone"]), (201, "+46 70-123 45 67"))
+        self.assertEqual(app.handle("GET", "/users/%d" % user["id"], {}, None, self.db)[1]["phone"], "+46 70-123 45 67")
+        self.assertEqual(app.handle("GET", "/users", {}, None, self.db)[1]["users"][0]["phone"], "+46 70-123 45 67")
+
+    def test_phone_optional(self):
+        for body in ({}, {"phone": None}):
+            body = dict(body, name="A", email="%d@example.com" % len(body))
+            status, user = app.handle("POST", "/users", {}, body, self.db)
+            self.assertEqual((status, user["phone"]), (201, None))
+
+    def test_phone_invalid(self):
+        for phone in ["123456", "1" * 16, "abc1234567", "12+34567890", "++1234567", "", "   ", "123-456-78x", 1234567]:
+            status, body = app.handle("POST", "/users", {}, {"name": "A", "email": "a@example.com", "phone": phone}, self.db)
+            self.assertEqual((status, body), (400, {"errors": ["phone is invalid"]}), phone)
+
+    def test_phone_digit_bounds(self):
+        for phone in ["1234567", "+" + "1" * 15, "12 34-567"]:
+            status, _ = app.handle("POST", "/users", {}, {"name": "A", "email": "%s@example.com" % len(phone), "phone": phone}, self.db)
+            self.assertEqual(status, 201, phone)
+
 
 if __name__ == "__main__":
     unittest.main()
diff --git a/svc/validate.py b/svc/validate.py
index 89ff6f5..73f1654 100644
--- a/svc/validate.py
+++ b/svc/validate.py
@@ -2,6 +2,11 @@
 import re
 
 EMAIL = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
+PHONE = re.compile(r"^\+?[0-9 -]+$")
+
+
+def valid_phone(phone):
+    return isinstance(phone, str) and bool(PHONE.match(phone)) and 7 <= sum(c.isdigit() for c in phone) <= 15
 
 
 def validate_user(payload):
@@ -12,4 +17,7 @@ def validate_user(payload):
     email = payload.get("email")
     if not isinstance(email, str) or not EMAIL.match(email):
         errors.append("email is invalid")
+    phone = payload.get("phone")
+    if phone is not None and not valid_phone(phone):
+        errors.append("phone is invalid")
     return errors
