+class ImportTests(unittest.TestCase):
+    def setUp(self):
+        self.db = store.connect()
+        store.migrate(self.db)
+
+    def imp(self, body):
+        return app.handle("POST", "/users/import", {}, body, self.db)
+
+    def count(self):
+        return len(app.handle("GET", "/users", {}, None, self.db)[1]["users"])
+
+    def test_success_in_order(self):
+        status, body = self.imp({"users": [{"name": " B ", "email": "b@example.com"}, {"name": "A", "email": "a@example.com"}]})
+        self.assertEqual(status, 201)
+        self.assertEqual([u["name"] for u in body["users"]], ["B", "A"])
+        self.assertEqual(self.count(), 2)
+
+    def test_bad_shape(self):
+        for body in (None, [], {}, {"users": []}, {"users": "x"}, {"users": {"a": 1}}):
+            self.assertEqual(self.imp(body)[0], 400, body)
+        self.assertEqual(self.count(), 0)
+
+    def test_entry_not_object(self):
+        status, body = self.imp({"users": [{"name": "A", "email": "a@example.com"}, "x"]})
+        self.assertEqual(status, 400)
+        self.assertEqual(body["errors"][0]["index"], 1)
+        self.assertEqual(self.count(), 0)
+
+    def test_validation_errors(self):
+        status, body = self.imp({"users": [{"name": "A", "email": "a@example.com"}, {"name": "", "email": "nope"}]})
+        self.assertEqual(status, 400)
+        self.assertEqual(body, {"errors": [{"index": 1, "errors": ["name is required", "email is invalid"]}]})
+        self.assertEqual(self.count(), 0)
+
+    def test_duplicate_in_batch_ignoring_case(self):
+        status, body = self.imp({"users": [{"name": "A", "email": "a@example.com"}, {"name": "B", "email": "b@example.com"},
+                                           {"name": "C", "email": "A@Example.com"}]})
+        self.assertEqual(status, 409)
+        self.assertEqual(body, {"errors": [{"index": 2, "error": "email already registered"}]})
+        self.assertEqual(self.count(), 0)
+
+    def test_existing_email_ignoring_case(self):
+        app.handle("POST", "/users", {}, {"name": "Ada", "email": "Ada@example.com"}, self.db)
+        status, body = self.imp({"users": [{"name": "B", "email": "b@example.com"}, {"name": "A", "email": "ada@EXAMPLE.com"}]})
+        self.assertEqual(status, 409)
+        self.assertEqual(body, {"errors": [{"index": 1, "error": "email already registered"}]})
+        self.assertEqual(self.count(), 1)
+
+    def test_limit(self):
+        def batch(n):
+            return {"users": [{"name": "U", "email": "u%d@example.com" % i} for i in range(n)]}
+        self.assertEqual(self.imp(batch(101))[0], 413)
+        self.assertEqual(self.count(), 0)
+        self.assertEqual(self.imp(batch(100))[0], 201)
+        self.assertEqual(self.count(), 100)
+
+    def test_rollback_on_db_failure(self):
+        with self.assertRaises(sqlite3.IntegrityError):
+            store.create_users(self.db, [("A", "a@example.com"), ("B", "a@example.com")])
+        self.assertEqual(self.count(), 0)
+
+
 if __name__ == "__main__":
     unittest.main()
