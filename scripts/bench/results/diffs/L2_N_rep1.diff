+def import_users(body, db):
+    """All-or-nothing batch create. Checks run in order: shape (400), size (413), validation (400), duplicates (409)."""
+    users = body.get("users") if isinstance(body, dict) else None
+    if not isinstance(users, list) or not users:
+        return 400, {"error": "users must be a non-empty list"}
+    if len(users) > MAX_IMPORT:
+        return 413, {"error": "at most %d users per request" % MAX_IMPORT}
+    errors = []
+    for i, entry in enumerate(users):
+        entry_errors = validate.validate_user(entry) if isinstance(entry, dict) else ["entry must be an object"]
+        if entry_errors:
+            errors.append({"index": i, "errors": entry_errors})
+    if errors:
+        return 400, {"errors": errors}
+    emails = [u["email"].lower() for u in users]
+    return _create_batch(users, emails, db)
+
+
+def _conflicts(emails, db):
+    taken = store.existing_emails(db, emails)
+    seen = set()
+    errors = []
+    for i, email in enumerate(emails):
+        if email in taken or email in seen:
+            errors.append({"index": i, "error": "email already registered"})
+        seen.add(email)
+    return errors
+
+
+def _create_batch(users, emails, db):
+    errors = _conflicts(emails, db)
+    if errors:
+        return 409, {"errors": errors}
+    try:
+        created = store.create_users(db, [(u["name"].strip(), u["email"]) for u in users])
+    except sqlite3.IntegrityError:  # lost a race with a concurrent insert; nothing was created
+        return 409, {"errors": _conflicts(emails, db) or [{"index": 0, "error": "email already registered"}]}
+    return 201, {"users": created}
