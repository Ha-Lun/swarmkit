 | GET | /users | All users, by id. |
 | GET | /users/<id> | One user, or 404. |
 | POST | /users | Create a user from `{name, email}`. 201, 400 on invalid input, 409 if the email is taken. |
+| POST | /users/import | Create many users from `{"users": [{name, email}, ...]}`, all or nothing. See below. |
 
 A user is `{id, name, email}`.
+
+## POST /users/import
+
+Body: `{"users": [{"name": ..., "email": ...}, ...]}` with 1 to 100 entries. Each entry is validated like `POST /users`.
+Either every user is created or none is.
+
+| Status | When | Body |
+|---|---|---|
+| 201 | All created | `{"users": [...]}` in input order |
+| 400 | `users` missing, empty or not a list | `{"error": "..."}` |
+| 400 | An entry is not an object or fails validation | `{"errors": [{"index": i, "errors": [...]}]}`, one item per bad entry |
+| 409 | An email is already registered, or repeats an earlier entry in the batch | `{"errors": [{"index": i, "error": "email already registered"}]}`, `index` is the later entry |
+| 413 | More than 100 entries | `{"error": "..."}` |
+
+Emails are compared ignoring capitalisation. Validation (400) is checked before duplicates (409).
diff --git a/svc/store.py b/svc/store.py
index 6c5bc2c..ee66510 100644
--- a/svc/store.py
+++ b/svc/store.py
@@ -38,3 +38,23 @@ def get_user(db, user_id):
 
 def list_users(db):
     return [dict(r) for r in db.execute("SELECT * FROM users ORDER BY id")]
+
+
+def existing_emails(db, emails):
+    """The subset of emails (compared ignoring case) already registered, as lowercase strings."""
+    found = set()
+    for email in {e.lower() for e in emails}:
+        if db.execute("SELECT 1 FROM users WHERE lower(email) = ?", (email,)).fetchone():
+            found.add(email)
+    return found
+
+
+def create_users(db, rows):
+    """Insert all (name, email) rows in one transaction: either every user is created or none. Returns them in order."""
+    try:
+        ids = [db.execute("INSERT INTO users (name, email) VALUES (?, ?)", row).lastrowid for row in rows]
+        db.commit()
+    except Exception:
+        db.rollback()
+        raise
+    return [get_user(db, i) for i in ids]
