--- a/svc/store.py
+++ b/svc/store.py
@@ -31,6 +31,19 @@ def create_user(db, name, email):
     return get_user(db, cur.lastrowid)
 
 
+def create_users(db, rows):
+    """Insert all (name, email) rows in one transaction: all are created or none."""
+    with db:
+        ids = [db.execute("INSERT INTO users (name, email) VALUES (?, ?)", row).lastrowid for row in rows]
+    return [get_user(db, i) for i in ids]
+
+
+def existing_emails(db, emails):
+    """The lower-cased subset of emails already registered, ignoring capitalisation."""
+    wanted = {e.lower() for e in emails}
+    return {r["email"].lower() for r in db.execute("SELECT email FROM users")} & wanted
+
+
 def get_user(db, user_id):
     row = db.execute("SELECT * FROM users WHERE id = ?", (user_id,)).fetchone()
     return dict(row) if row else None
