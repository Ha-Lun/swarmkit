 import validate
 
 
+MAX_IMPORT = 100
+
+
+def import_users(body, db):
+    users = body.get("users") if isinstance(body, dict) else None
+    if not isinstance(users, list) or not users:
+        return 400, {"error": "users must be a non-empty list"}
+    if len(users) > MAX_IMPORT:
+        return 413, {"error": "at most %d users per request" % MAX_IMPORT}
+    errors = []
+    for i, entry in enumerate(users):
+        entry_errors = validate.validate_user(entry) if isinstance(entry, dict) else ["entry must be an object"]
+        if entry_errors:
+            errors.append({"index": i, "errors": entry_errors})
+    if errors:
+        return 400, {"errors": errors}
+    taken = store.existing_emails(db, [u["email"] for u in users])
+    conflicts = []
+    for i, entry in enumerate(users):
+        key = entry["email"].lower()
+        if key in taken:
+            conflicts.append({"index": i, "error": "email already registered"})
+        taken.add(key)
+    if conflicts:
+        return 409, {"errors": conflicts}
+    try:
+        return 201, {"users": store.create_users(db, [(u["name"].strip(), u["email"]) for u in users])}
+    except sqlite3.IntegrityError:
+        return 409, {"error": "email already registered"}
+
+
