+    if method == "POST" and path == "/users/import":
+        return import_users(body, db)
     return 404, {"error": "not found"}
+
+
+MAX_IMPORT = 100
+
+
+def import_users(body, db):
+    users = body.get("users") if isinstance(body, dict) else None
+    if not isinstance(users, list) or not users:
+        return 400, {"errors": [{"error": "users must be a non-empty list"}]}
+    if len(users) > MAX_IMPORT:
+        return 413, {"error": "at most %d users per request" % MAX_IMPORT}
+
+    problems = []
+    for i, entry in enumerate(users):
+        errors = validate.validate_user(entry) if isinstance(entry, dict) else ["entry must be an object"]
+        if errors:
+            problems.append({"index": i, "errors": errors})
+    if problems:
+        return 400, {"errors": problems}
+
+    taken = store.existing_emails(db, [u["email"] for u in users])
+    seen = set()
+    conflicts = []
+    for i, u in enumerate(users):
+        key = u["email"].lower()
+        if key in taken or key in seen:
+            conflicts.append({"index": i, "error": "email already registered"})
+        seen.add(key)
+    if conflicts:
+        return 409, {"errors": conflicts}
+
+    created, failed = store.create_users(db, [(u["name"].strip(), u["email"]) for u in users])
+    if failed is not None:  # lost a race with a concurrent insert
+        return 409, {"errors": [{"index": failed, "error": "email already registered"}]}
+    return 201, {"users": created}
diff --git a/svc/docs/API.md b/svc/docs/API.md
index d96c758..649e679 100644
--- a/svc/docs/API.md
+++ b/svc/docs/API.md
@@ -6,5 +6,19 @@
 | GET | /users | All users, by id. |
 | GET | /users/<id> | One user, or 404. |
 | POST | /users | Create a user from `{name, email}`. 201, 400 on invalid input, 409 if the email is taken. |
+| POST | /users/import | Create many users from `{"users": [{name, email}, ...]}`, all or nothing. See below. |
+
+## POST /users/import
+
+At most 100 users per request. Each entry is validated like `POST /users`. Emails are compared ignoring capitalisation: an email may not already exist, nor appear twice in the batch.
+
+| Status | When | Body |
+|---|---|---|
+| 201 | All created | `{"users": [...]}` in input order |
+| 400 | `users` missing, empty or not a list (`{"errors": [{"error": "..."}]}`); an entry is not an object or is invalid | `{"errors": [{"index": i, "errors": [...]}]}` |
+| 409 | Email already registered, or repeated earlier in the batch | `{"errors": [{"index": i, "error": "email already registered"}]}` (index of the later entry) |
+| 413 | More than 100 users | `{"error": "..."}` |
+
+Validation (400) is checked before duplicates (409). On any error nothing is created.
 
 A user is `{id, name, email}`.
