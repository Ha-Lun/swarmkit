+def existing_emails(db, emails):
+    """The subset of `emails` (compared case-insensitively) already registered, as a lowercase set."""
+    wanted = {e.lower() for e in emails}
+    return {r["email"].lower() for r in db.execute("SELECT email FROM users")} & wanted
+
+
+def create_users(db, entries):
+    """Insert (name, email) pairs in one transaction: all or nothing.
+
+    Returns (users, None) on success, or (None, index) of the entry that hit a uniqueness conflict.
+    """
+    try:
+        ids = []
+        for i, (name, email) in enumerate(entries):
+            try:
+                ids.append(db.execute("INSERT INTO users (name, email) VALUES (?, ?)", (name, email)).lastrowid)
+            except sqlite3.IntegrityError:
+                db.rollback()
+                return None, i
+        db.commit()
+    except Exception:
+        db.rollback()
+        raise
+    return [get_user(db, i) for i in ids], None
+
+
 def get_user(db, user_id):
     row = db.execute("SELECT * FROM users WHERE id = ?", (user_id,)).fetchone()
     return dict(row) if row else None
