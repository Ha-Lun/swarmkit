         self.assertEqual([u["name"] for u in body["users"]], ["A", "B"])
 
+    def _create(self, name, email):
+        return app.handle("POST", "/users", {}, {"name": name, "email": email}, self.db)
+
+    def test_delete(self):
+        _, user = self._create("Ada", "ada@example.com")
+        self.assertEqual(app.handle("DELETE", "/users/%d" % user["id"], {}, None, self.db), (200, {"deleted": user["id"]}))
+        self.assertEqual(app.handle("GET", "/users/%d" % user["id"], {}, None, self.db)[0], 404)
+        self.assertEqual(app.handle("GET", "/users", {}, None, self.db)[1], {"users": []})
+        row = self.db.execute("SELECT deleted_at FROM users WHERE id = ?", (user["id"],)).fetchone()
+        self.assertIsNotNone(row["deleted_at"])
+
+    def test_delete_unknown_or_twice(self):
+        self.assertEqual(app.handle("DELETE", "/users/99", {}, None, self.db)[0], 404)
+        self.assertEqual(app.handle("DELETE", "/users/abc", {}, None, self.db)[0], 404)
+        _, user = self._create("Ada", "ada@example.com")
+        app.handle("DELETE", "/users/%d" % user["id"], {}, None, self.db)
+        self.assertEqual(app.handle("DELETE", "/users/%d" % user["id"], {}, None, self.db)[0], 404)
+
+    def test_email_reusable_after_delete(self):
+        _, user = self._create("Ada", "ada@example.com")
+        app.handle("DELETE", "/users/%d" % user["id"], {}, None, self.db)
+        status, again = self._create("Ada", "ada@example.com")
+        self.assertEqual(status, 201)
+        self.assertNotEqual(again["id"], user["id"])
+        self.assertEqual(self._create("Ada 3", "ada@example.com")[0], 409)
+
 
 if __name__ == "__main__":
