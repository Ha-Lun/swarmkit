+USER_COLUMNS = "id, name, email"
+
+
 def get_user(db, user_id):
-    row = db.execute("SELECT * FROM users WHERE id = ?", (user_id,)).fetchone()
+    row = db.execute("SELECT %s FROM users WHERE id = ? AND deleted_at IS NULL" % USER_COLUMNS, (user_id,)).fetchone()
     return dict(row) if row else None
 
 
 def list_users(db):
-    return [dict(r) for r in db.execute("SELECT * FROM users ORDER BY id")]
+    return [dict(r) for r in db.execute("SELECT %s FROM users WHERE deleted_at IS NULL ORDER BY id" % USER_COLUMNS)]
+
+
+def delete_user(db, user_id):
+    """Soft delete. Returns False if there is no active user with that id."""
+    cur = db.execute(
+        "UPDATE users SET deleted_at = strftime('%Y-%m-%dT%H:%M:%fZ', 'now') WHERE id = ? AND deleted_at IS NULL",
+        (user_id,))
+    db.commit()
+    return cur.rowcount > 0
