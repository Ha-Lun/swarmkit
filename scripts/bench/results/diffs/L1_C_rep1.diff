diff --git a/svc/docs/API.md b/svc/docs/API.md
index d96c758..61fd860 100644
--- a/svc/docs/API.md
+++ b/svc/docs/API.md
@@ -6,5 +6,8 @@
 | GET | /users | All users, by id. |
 | GET | /users/<id> | One user, or 404. |
 | POST | /users | Create a user from `{name, email}`. 201, 400 on invalid input, 409 if the email is taken. |
+| DELETE | /users/<id> | Soft delete: the row is kept with a `deleted_at` timestamp. 200 with `{"deleted": <id>}`, 404 if unknown or already deleted. |
+
+Deleted users are hidden from `GET /users` and `GET /users/<id>` (404), and their email can be registered again. Email is unique among active users only.
 
 A user is `{id, name, email}`.
diff --git a/svc/migrations/002_soft_delete.sql b/svc/migrations/002_soft_delete.sql
new file mode 100644
index 0000000..f664eb4
--- /dev/null
+++ b/svc/migrations/002_soft_delete.sql
@@ -0,0 +1,16 @@
+-- Soft delete: add deleted_at, and make email unique among active users only.
+-- SQLite cannot drop the column-level UNIQUE, so rebuild the table, keeping ids and the id sequence.
+BEGIN;
+CREATE TABLE users_new (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  name TEXT NOT NULL,
+  email TEXT NOT NULL,
+  deleted_at TEXT
+);
+INSERT INTO users_new (id, name, email) SELECT id, name, email FROM users;
+DELETE FROM sqlite_sequence WHERE name = 'users_new';
+INSERT INTO sqlite_sequence (name, seq) SELECT 'users_new', seq FROM sqlite_sequence WHERE name = 'users';
+DROP TABLE users;
+ALTER TABLE users_new RENAME TO users;
+CREATE UNIQUE INDEX users_active_email ON users (email) WHERE deleted_at IS NULL;
+COMMIT;
