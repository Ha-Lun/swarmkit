{
  "mcpServers": {
    "cloudflare": { "url": "https://mcp.cloudflare.com/mcp" },
    "cloudflare-docs": { "url": "https://docs.mcp.cloudflare.com/mcp" },
    "cloudflare-bindings": { "url": "https://bindings.mcp.cloudflare.com/mcp" },
    "cloudflare-builds": { "url": "https://builds.mcp.cloudflare.com/mcp" },
    "cloudflare-observability": { "url": "https://observability.mcp.cloudflare.com/mcp" },
    "gemini-mcp-tool": {
      "command": "npx",
      "args": ["-y", "gemini-mcp-tool@latest"],
      "env": {
        "ANTIGRAVITY_ACCOUNTS_PATH": "$HOME/.opencode/antigravity-accounts.json"
      }
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@latest"]
    },
    "blender": {
      "command": "uvx",
      "args": ["blender-mcp"]
    },
    "google-search-console": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-google-search-console@latest"]
    },
    "google-trends": {
      "command": "npx",
      "args": ["-y", "google-trends-mcp@latest"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    }
  }
}
